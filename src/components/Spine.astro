---
import { publisherMark, spineLabel, type Book } from '~/lib/shelf';

interface Props {
  book: Book;
}

const { book } = Astro.props;
const { label, volume } = spineLabel(book.title);
---

<span class="spine__body">
  {volume !== null && <span class="spine__vol">{volume}</span>}
  <span class="spine__title">{label}</span>
  <span class="spine__foot">{publisherMark(book.publisher)}</span>
</span>

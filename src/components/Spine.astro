---
import { publisherMark, spineLabel, type Book } from '~/lib/shelf';

interface Props {
  book: Book;
}

const { book } = Astro.props;
const { label, volume } = spineLabel(book.title);
// The spine's own size, so the browser reserves the right space before it loads.
const photoHeight = 1000;
const photoWidth = Math.round(photoHeight * (book.spineRatio ?? 0.2));
---

{
  book.spineImage ? (
    <span class="spine__body spine__body--photo">
      <img class="spine__photo" src={book.spineImage} alt="" width={photoWidth} height={photoHeight} loading="lazy" decoding="async" draggable="false" />
    </span>
  ) : (
    <span class="spine__body">
      {volume !== null && <span class="spine__vol">{volume}</span>}
      <span class="spine__title">{label}</span>
      <span class="spine__foot">{publisherMark(book.publisher)}</span>
    </span>
  )
}

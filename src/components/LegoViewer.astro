---
import { modelCredit, modelled } from '~/data/lego';
const first = modelled[0];
---

<lego-viewer class="viewer">
  <div class="viewer__picker" role="group" aria-label="Choose a set to build">
    {
      modelled.map((set, index) => (
        <button
          type="button"
          class="viewer__pick"
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-url={set.model.url}
          data-kind={set.model.kind}
          data-turn={set.model.kind === 'scan' ? set.model.turn : undefined}
          data-name={set.name}
          data-number={set.number}
          data-model-credit={modelCredit(set)}
          data-built={String(set.built)}
        >
          {set.name}
          {set.model.kind === 'scan' && <span class="viewer__flag viewer__flag--scan">Scan</span>}
          {!set.built && <span class="viewer__flag">In the box</span>}
        </button>
      ))
    }
  </div>

  <div class="viewer__stage" data-stage>
    <p class="viewer__status" data-status>
      The {first?.name} builds itself here, brick by brick, in the order of its real instructions.
    </p>
  </div>

  <div class="viewer__bar">
    <p class="viewer__progress" data-progress>Ready to build</p>
    <button type="button" class="viewer__replay" data-replay disabled>Build it again</button>
  </div>
  <p class="viewer__credit" data-credit>{first && modelCredit(first)}</p>
</lego-viewer>

<script>
  import type { LegoBuild } from '~/scripts/legoBuild';

  class LegoViewer extends HTMLElement {
    #build: LegoBuild | null = null;
    #loading: Promise<LegoBuild | null> | null = null;
    #current: HTMLButtonElement | null = null;
    #onScreen = false;
    #scan = false;
    readonly #downloads = new Map<string, Promise<ArrayBuffer>>();

    connectedCallback() {
      const picks = [...this.querySelectorAll<HTMLButtonElement>('[data-url]')];
      for (const pick of picks) pick.addEventListener('click', () => this.#show(pick));
      // One button: skip to the finished model while it builds, build it again once it's done.
      this.querySelector('[data-replay]')?.addEventListener('click', () => {
        const build = this.#build;
        if (!build) return;
        if (build.building) build.skip();
        else build.build();
        this.#replay(build.building ? 'skip' : 'again');
      });

      // Load three.js and the first model only when the viewer comes near the screen.
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          near.disconnect();
          if (!this.#current && picks[0]) this.#show(picks[0]);
        },
        // Start well before it scrolls into view; the build itself waits until it's on screen.
        { rootMargin: '900px 0px' },
      );
      near.observe(this);

      // Draw only while a real part of the viewer is on screen, not a sliver at the edge.
      const seen = new IntersectionObserver(
        (entries) => {
          const entry = entries[entries.length - 1];
          this.#onScreen = !!entry && entry.intersectionRatio >= 0.2;
          this.#build?.setVisible(this.#onScreen);
        },
        { threshold: [0, 0.2] },
      );
      seen.observe(this);
    }

    async #engine(): Promise<LegoBuild | null> {
      if (this.#build) return this.#build;
      this.#loading ??= (async () => {
        const stage = this.querySelector<HTMLElement>('[data-stage]');
        if (!stage) return null;
        try {
          const { LegoBuild } = await import('~/scripts/legoBuild');
          this.#build = new LegoBuild(stage, {
            reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
            interactive: matchMedia('(pointer: fine)').matches,
          });
          this.#build.setVisible(this.#onScreen);
          return this.#build;
        } catch {
          this.#status('This browser could not start 3D graphics, so the model can’t be shown here.');
          return null;
        }
      })();
      return this.#loading;
    }

    async #show(pick: HTMLButtonElement) {
      this.#current = pick;
      for (const other of this.querySelectorAll('[data-url]')) other.setAttribute('aria-pressed', String(other === pick));
      const { url = '', kind = 'ldraw', name = '', modelCredit = '', turn = '0' } = pick.dataset;
      const scan = kind === 'scan';
      this.#scan = scan;
      this.#credit(modelCredit);
      this.#status(`Loading the ${name}…`);
      this.#progress(scan ? 'Loading the scan' : 'Loading parts');
      this.#replay('loading');

      // Fetch an LDraw model while three.js loads, rather than after, and only once per set.
      let download = scan ? undefined : this.#downloads.get(url);
      if (!scan && !download) {
        download = fetch(url).then((response) => {
          if (!response.ok) throw new Error(`Could not load ${url} (${response.status})`);
          return response.arrayBuffer();
        });
        download.catch(() => this.#downloads.delete(url));
        this.#downloads.set(url, download);
      }

      const build = await this.#engine();
      if (!build || this.#current !== pick) return;
      const callbacks = {
        onProgress: (step: number, steps: number) => this.#progress(`Step ${step} of ${steps}`),
        onDone: () => this.#replay('again'),
      };
      try {
        if (scan) {
          await build.showScan(url, callbacks, Number(turn));
          this.#progress('Scan of my own build');
        } else {
          await build.show(url, callbacks, download);
        }
        if (this.#current !== pick) return;
        this.#status('');
        this.#replay(build.building ? 'skip' : 'again');
      } catch {
        this.#status(`The ${name} model didn’t load. Try again in a moment.`);
      }
    }

    #replay(state: 'loading' | 'skip' | 'again') {
      const replay = this.querySelector<HTMLButtonElement>('[data-replay]');
      if (!replay) return;
      replay.disabled = state === 'loading';
      replay.textContent = state === 'skip' ? 'Skip to the end' : this.#scan ? 'Show it again' : 'Build it again';
    }

    #status(text: string) {
      const status = this.querySelector<HTMLElement>('[data-status]');
      if (!status) return;
      status.textContent = text;
      status.hidden = !text;
    }

    #progress(text: string) {
      const progress = this.querySelector('[data-progress]');
      if (progress) progress.textContent = text;
    }

    #credit(text: string) {
      const credit = this.querySelector('[data-credit]');
      if (credit) credit.textContent = text;
    }
  }

  customElements.define('lego-viewer', LegoViewer);
</script>

<style>
  .viewer {
    display: block;
    margin-bottom: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--paper-raised);
    overflow: hidden;
  }

  .viewer__picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 1rem 1.125rem;
    border-bottom: 1px solid var(--rule);
  }

  .viewer__pick {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .viewer__pick[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .viewer__flag {
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-size: 0.7rem;
  }

  .viewer__flag--scan {
    background: var(--process-cyan);
  }

  /* The build happens on a yellow baseplate of dots, like the book stage. */
  .viewer__stage {
    position: relative;
    display: grid;
    place-items: center;
    height: clamp(20rem, 52vw, 32rem);
    background:
      radial-gradient(circle, color-mix(in srgb, var(--process-magenta) 30%, transparent) 0 30%, transparent 33%) 0 0 / 16px
        16px,
      color-mix(in srgb, var(--process-yellow) 80%, var(--paper));
    cursor: grab;
  }

  .viewer__stage:active {
    cursor: grabbing;
  }

  .viewer__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  .viewer__status {
    position: relative;
    z-index: 1;
    max-width: 26rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.85);
    color: #1d2024;
    text-align: center;
    font-size: var(--text-sm);
  }

  .viewer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1.125rem 0.25rem;
  }

  .viewer__progress {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }

  .viewer__replay {
    padding: 0.35rem 0.9rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: none;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .viewer__replay:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .viewer__credit {
    padding: 0.25rem 1.125rem 0.9rem;
    color: var(--ink-3);
    font-size: 0.78rem;
  }
</style>

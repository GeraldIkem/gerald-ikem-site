---
import { modelCredit, modelled } from '~/data/lego';
import { SPEEDS } from '~/lib/buildSchedule';
const first = modelled[0];
---

<lego-viewer class="viewer">
  <div class="viewer__picker" role="group" aria-label="Choose a set to build">
    {
      modelled.map((set, index) => (
        <button
          type="button"
          class="viewer__pick"
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-url={set.model.url}
          data-kind={set.model.kind}
          data-turn={set.model.kind === 'scan' ? set.model.turn : undefined}
          data-name={set.name}
          data-number={set.number}
          data-model-credit={modelCredit(set)}
          data-built={String(set.built)}
        >
          {set.name}
          {set.model.kind === 'scan' && <span class="viewer__flag viewer__flag--scan">Scan</span>}
          {!set.built && <span class="viewer__flag">In the box</span>}
        </button>
      ))
    }
  </div>

  <div class="viewer__stage" data-stage>
    <p class="viewer__status" data-status>
      The {first?.name} builds itself here, brick by brick, in the order of its real instructions.
    </p>
  </div>

  <div class="viewer__bar">
    <div class="viewer__transport">
      <button type="button" class="viewer__ctl" data-back data-steps-only aria-label="Back a step" title="Back a step" disabled>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4h2.5v12H4zM16 4v12L7.5 10z"></path></svg>
      </button>
      <button type="button" class="viewer__ctl viewer__ctl--play" data-play data-state="play" aria-label="Play" title="Play" disabled>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path class="viewer__icon-play" d="M6 3.5 16.5 10 6 16.5z"></path>
          <path class="viewer__icon-pause" d="M5 4h3.5v12H5zm6.5 0H15v12h-3.5z"></path>
          <path
            class="viewer__icon-again"
            d="M10 3.5V1L6 4.5 10 8V5.5a4.5 4.5 0 1 1-4.5 4.5h-2A6.5 6.5 0 1 0 10 3.5z"
          ></path>
        </svg>
      </button>
      <button type="button" class="viewer__ctl" data-forward data-steps-only aria-label="Forward a step" title="Forward a step" disabled>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M13.5 4H16v12h-2.5zM4 4v12l8.5-6z"></path></svg>
      </button>
    </div>
    <p class="viewer__progress" data-progress>Ready to build</p>
    <div class="viewer__speed" role="group" aria-label="Speed">
      {
        SPEEDS.map((speed) => (
          <button type="button" class="viewer__speed-pick" data-speed={speed} aria-pressed={speed === 1 ? 'true' : 'false'}>
            {speed}×
          </button>
        ))
      }
    </div>
    <input
      class="viewer__scrub"
      type="range"
      min="0"
      max="0"
      value="0"
      step="1"
      aria-label="Step"
      data-scrub
      data-steps-only
      disabled
    />
  </div>
  <p class="viewer__credit" data-credit>{first && modelCredit(first)}</p>
</lego-viewer>

<script>
  import type { LegoBuild, PlayState } from '~/scripts/legoBuild';

  const SPEED_KEY = 'gerald-ikem:lego-speed';

  class LegoViewer extends HTMLElement {
    #build: LegoBuild | null = null;
    #loading: Promise<LegoBuild | null> | null = null;
    #current: HTMLButtonElement | null = null;
    #onScreen = false;
    #scan = false;
    #state: PlayState | null = null;
    #step = 0;
    #speed = 1;
    readonly #downloads = new Map<string, Promise<ArrayBuffer>>();

    connectedCallback() {
      const picks = [...this.querySelectorAll<HTMLButtonElement>('[data-url]')];
      for (const pick of picks) pick.addEventListener('click', () => this.#show(pick));

      // Play and pause like a video; once it's finished, the same button builds it again.
      this.#control('[data-play]').addEventListener('click', () => {
        if (this.#state?.playing) this.#build?.pause();
        else this.#build?.play();
      });
      this.#control('[data-back]').addEventListener('click', () => this.#build?.stepBy(-1));
      this.#control('[data-forward]').addEventListener('click', () => this.#build?.stepBy(1));
      // Dragging (or arrowing) along the steps stands the build still at that step.
      this.#control<HTMLInputElement>('[data-scrub]').addEventListener('input', (event) => {
        this.#build?.seek(Number((event.target as HTMLInputElement).value));
      });
      for (const pick of this.querySelectorAll<HTMLButtonElement>('[data-speed]')) {
        pick.addEventListener('click', () => this.#setSpeed(Number(pick.dataset['speed']), true));
      }
      try {
        const saved = Number(localStorage.getItem(SPEED_KEY));
        if (this.querySelector(`[data-speed="${saved}"]`)) this.#setSpeed(saved, false);
      } catch {
        // No storage, so it starts at 1×.
      }

      // Load three.js and the first model only when the viewer comes near the screen.
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          near.disconnect();
          if (!this.#current && picks[0]) this.#show(picks[0]);
        },
        // Start well before it scrolls into view; the build itself waits until it's on screen.
        { rootMargin: '900px 0px' },
      );
      near.observe(this);

      // Draw only while a real part of the viewer is on screen, not a sliver at the edge.
      const seen = new IntersectionObserver(
        (entries) => {
          const entry = entries[entries.length - 1];
          this.#onScreen = !!entry && entry.intersectionRatio >= 0.2;
          this.#build?.setVisible(this.#onScreen);
        },
        { threshold: [0, 0.2] },
      );
      seen.observe(this);
    }

    async #engine(): Promise<LegoBuild | null> {
      if (this.#build) return this.#build;
      this.#loading ??= (async () => {
        const stage = this.querySelector<HTMLElement>('[data-stage]');
        if (!stage) return null;
        try {
          const { LegoBuild } = await import('~/scripts/legoBuild');
          this.#build = new LegoBuild(stage, {
            reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
            interactive: matchMedia('(pointer: fine)').matches,
          });
          this.#build.setSpeed(this.#speed);
          this.#build.setVisible(this.#onScreen);
          return this.#build;
        } catch {
          this.#status('This browser could not start 3D graphics, so the model can’t be shown here.');
          return null;
        }
      })();
      return this.#loading;
    }

    async #show(pick: HTMLButtonElement) {
      this.#current = pick;
      for (const other of this.querySelectorAll('[data-url]')) other.setAttribute('aria-pressed', String(other === pick));
      const { url = '', kind = 'ldraw', name = '', modelCredit = '', turn = '0' } = pick.dataset;
      const scan = kind === 'scan';
      this.#scan = scan;
      this.#credit(modelCredit);
      this.#status(`Loading the ${name}…`);
      this.#progress(scan ? 'Loading the scan' : 'Loading parts');
      this.#step = 0;
      this.#playState(null);
      // A scan has no steps to move between.
      for (const control of this.querySelectorAll<HTMLElement>('[data-steps-only]')) control.hidden = scan;

      // Fetch an LDraw model while three.js loads, rather than after, and only once per set.
      let download = scan ? undefined : this.#downloads.get(url);
      if (!scan && !download) {
        download = fetch(url).then((response) => {
          if (!response.ok) throw new Error(`Could not load ${url} (${response.status})`);
          return response.arrayBuffer();
        });
        download.catch(() => this.#downloads.delete(url));
        this.#downloads.set(url, download);
      }

      const build = await this.#engine();
      if (!build || this.#current !== pick) return;
      const callbacks = {
        onProgress: (step: number, steps: number) => {
          this.#progress(`Step ${step} of ${steps}`);
          const scrub = this.#control<HTMLInputElement>('[data-scrub]');
          scrub.max = String(steps);
          scrub.value = String(step);
          scrub.setAttribute('aria-valuetext', `Step ${step} of ${steps}`);
          this.#step = step;
          this.#control('[data-back]').disabled = !this.#state || step === 0;
        },
        onState: (state: PlayState) => this.#playState(state),
      };
      try {
        if (scan) {
          await build.showScan(url, callbacks, Number(turn));
          this.#progress('Scan of my own build');
        } else {
          await build.show(url, callbacks, download);
        }
        if (this.#current !== pick) return;
        this.#status('');
      } catch {
        this.#status(`The ${name} model didn’t load. Try again in a moment.`);
      }
    }

    /** Show what the play button will do next, or turn the controls off while a model loads. */
    #playState(state: PlayState | null) {
      this.#state = state;
      const play = this.#control('[data-play]');
      const next = !state ? 'play' : state.playing ? 'pause' : state.atEnd ? 'again' : 'play';
      const label = { play: 'Play', pause: 'Pause', again: this.#scan ? 'Show it again' : 'Build it again' }[next];
      play.dataset['state'] = next;
      play.setAttribute('aria-label', label);
      play.title = label;
      for (const control of this.querySelectorAll<HTMLButtonElement | HTMLInputElement>('[data-play], [data-back], [data-forward], [data-scrub]')) {
        control.disabled = !state;
      }
      if (!state) return;
      this.#control('[data-back]').disabled = this.#step === 0;
      this.#control('[data-forward]').disabled = state.atEnd;
    }

    #setSpeed(speed: number, remember: boolean) {
      this.#speed = speed;
      for (const pick of this.querySelectorAll('[data-speed]')) {
        pick.setAttribute('aria-pressed', String(Number((pick as HTMLElement).dataset['speed']) === speed));
      }
      this.#build?.setSpeed(speed);
      if (!remember) return;
      try {
        localStorage.setItem(SPEED_KEY, String(speed));
      } catch {
        // Not remembered, which is fine.
      }
    }

    #control<T extends HTMLElement = HTMLButtonElement>(selector: string): T {
      return this.querySelector<T>(selector)!;
    }

    #status(text: string) {
      const status = this.querySelector<HTMLElement>('[data-status]');
      if (!status) return;
      status.textContent = text;
      status.hidden = !text;
    }

    #progress(text: string) {
      const progress = this.querySelector('[data-progress]');
      if (progress) progress.textContent = text;
    }

    #credit(text: string) {
      const credit = this.querySelector('[data-credit]');
      if (credit) credit.textContent = text;
    }
  }

  customElements.define('lego-viewer', LegoViewer);
</script>

<style>
  .viewer {
    display: block;
    margin-bottom: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--paper-raised);
    overflow: hidden;
  }

  .viewer__picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 1rem 1.125rem;
    border-bottom: 1px solid var(--rule);
  }

  .viewer__pick {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .viewer__pick[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .viewer__flag {
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-size: 0.7rem;
  }

  .viewer__flag--scan {
    background: var(--process-cyan);
  }

  /* The build happens on a yellow baseplate of dots, like the book stage. */
  .viewer__stage {
    position: relative;
    display: grid;
    place-items: center;
    height: clamp(20rem, 52vw, 32rem);
    background:
      radial-gradient(circle, color-mix(in srgb, var(--process-magenta) 30%, transparent) 0 30%, transparent 33%) 0 0 / 16px
        16px,
      color-mix(in srgb, var(--process-yellow) 80%, var(--paper));
    cursor: grab;
  }

  .viewer__stage:active {
    cursor: grabbing;
  }

  .viewer__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  .viewer__status {
    position: relative;
    z-index: 1;
    max-width: 26rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.85);
    color: #1d2024;
    text-align: center;
    font-size: var(--text-sm);
  }

  .viewer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1.125rem 0.25rem;
  }

  .viewer__progress {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }

  .viewer__transport {
    display: flex;
    gap: 0.375rem;
  }

  .viewer__ctl {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .viewer__ctl svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .viewer__ctl--play {
    background: var(--ink);
    color: var(--paper);
  }

  /* The play button shows what it will do: play, pause, or build it again. */
  .viewer__ctl--play path {
    display: none;
  }

  .viewer__ctl--play[data-state='play'] .viewer__icon-play,
  .viewer__ctl--play[data-state='pause'] .viewer__icon-pause,
  .viewer__ctl--play[data-state='again'] .viewer__icon-again {
    display: inline;
  }

  .viewer__ctl:disabled,
  .viewer__scrub:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .viewer__ctl[hidden],
  .viewer__scrub[hidden] {
    display: none;
  }

  .viewer__speed {
    display: flex;
    gap: 0.25rem;
  }

  .viewer__speed-pick {
    min-width: 2.5rem;
    min-height: 2.25rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .viewer__speed-pick[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  /* The steps, start to finish, to drag along. */
  .viewer__scrub {
    flex-basis: 100%;
    width: 100%;
    margin: 0.25rem 0 0;
    accent-color: var(--process-magenta);
    cursor: pointer;
  }

  .viewer__credit {
    padding: 0.25rem 1.125rem 0.9rem;
    color: var(--ink-3);
    font-size: 0.78rem;
  }
</style>

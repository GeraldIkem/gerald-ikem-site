---
/**
 * A trace of the visitor's own request for this page, drawn from the
 * Navigation and Resource Timing entries their browser records.
 */
---

<page-trace class="trace panel">
  <figure>
    <div class="trace__head">
      <figcaption class="trace__title">Your request for this page</figcaption>
      <p class="trace__total" data-total></p>
    </div>
    <div class="trace__body" data-body>
      <p class="trace__placeholder">
        Measuring. Your browser records how long each step of loading this page took, and the trace appears here
        once it has finished.
      </p>
    </div>
    <div class="trace__foot">
      <p class="trace__detail" data-detail aria-live="polite">
        Measured by your browser just now. Point at a row, or tab to it, to see what the step was.
      </p>
      <button class="trace__replay" type="button" data-replay hidden>Replay</button>
    </div>
  </figure>
</page-trace>

<script>
  import { buildPageTrace, formatMs, formatTick, niceStep, type PageTrace } from '~/lib/pageTrace';

  const REPLAY_MS = 1100;

  class PageTraceElement extends HTMLElement {
    #trace: PageTrace | null = null;
    #defaultDetail = '';

    connectedCallback() {
      const detail = this.querySelector<HTMLElement>('[data-detail]');
      this.#defaultDetail = detail?.textContent?.trim() ?? '';
      if (document.readyState === 'complete') {
        queueMicrotask(() => this.#measure());
      } else {
        addEventListener('load', () => setTimeout(() => this.#measure(), 0), { once: true });
      }
      this.querySelector('[data-replay]')?.addEventListener('click', () => this.#play());
    }

    #measure() {
      const [nav] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[];
      const body = this.querySelector<HTMLElement>('[data-body]');
      if (!body) return;
      if (!nav) {
        body.innerHTML = '<p class="trace__placeholder">This browser does not share navigation timing, so there is nothing to draw.</p>';
        return;
      }
      const resources = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      const paints = performance.getEntriesByType('paint');
      this.#trace = buildPageTrace(nav, resources, paints);
      this.#render(body, this.#trace);
      this.#play();
    }

    #render(body: HTMLElement, trace: PageTrace) {
      const total = Math.max(trace.total, 1);
      const pct = (ms: number) => `${Math.min((ms / total) * 100, 100)}%`;
      const step = niceStep(total, this.clientWidth < 520 ? 2 : 3);

      const totalEl = this.querySelector('[data-total]');
      if (totalEl) totalEl.textContent = `Ready in ${formatMs(trace.total)}`;

      const ticks: string[] = [];
      for (let t = 0; t <= total; t += step) {
        ticks.push(`<span class="trace__tick" style="--at:${pct(t)}">${formatTick(t)}</span>`);
      }

      const rows = trace.spans
        .map((span) => {
          const duration = span.end - span.start;
          return `
            <li>
              <button type="button" class="trace__row" data-depth="${span.depth}" data-kind="${span.kind}"
                data-about="${escape(span.about)}" data-label="${escape(span.label)}"
                data-start="${span.start}" data-duration="${duration}">
                <span class="trace__label">${escape(span.label)}</span>
                <span class="trace__track">
                  <span class="trace__bar" style="--left:${pct(span.start)};--width:${pct(duration)};--delay:${(span.start / total) * REPLAY_MS}ms;--grow:${Math.max((duration / total) * REPLAY_MS, 140)}ms"></span>
                </span>
                <span class="trace__ms">${formatMs(duration)}</span>
              </button>
            </li>`;
        })
        .join('');

      const marks = trace.marks
        .map(
          (mark) => `
            <span class="trace__mark" style="--at:${pct(mark.at)};--delay:${(mark.at / total) * REPLAY_MS}ms">
              <span class="trace__mark-label">${escape(mark.label)}, ${formatMs(mark.at)}</span>
            </span>`,
        )
        .join('');

      const notes: string[] = [];
      if (trace.fromCache) {
        notes.push('This copy came from your browser’s cache, so the network steps are missing. Reload while holding Shift to see the full trip.');
      } else if (trace.reusedConnection) {
        notes.push('Your browser reused a connection it already had open, so there was no lookup or handshake this time.');
      }

      body.innerHTML = `
        <div class="trace__grid">
          <div class="trace__axis" aria-hidden="true">${ticks.join('')}</div>
          <ol class="trace__rows" aria-label="Steps, in the order they started">${rows}</ol>
          <div class="trace__marks" aria-hidden="true">${marks}</div>
        </div>
        ${notes.map((note) => `<p class="trace__note">${note}</p>`).join('')}`;

      const detail = this.querySelector<HTMLElement>('[data-detail]');
      for (const row of body.querySelectorAll<HTMLButtonElement>('.trace__row')) {
        const show = () => {
          if (!detail) return;
          const start = Number(row.dataset['start']);
          const duration = Number(row.dataset['duration']);
          detail.textContent = `${row.dataset['label']}: started at ${formatMs(start)} and took ${formatMs(duration)}. ${row.dataset['about']}`;
        };
        const reset = () => {
          if (detail) detail.textContent = this.#defaultDetail;
        };
        row.addEventListener('pointerenter', show);
        row.addEventListener('focus', show);
        row.addEventListener('click', show);
        row.addEventListener('pointerleave', () => {
          if (document.activeElement !== row) reset();
        });
        row.addEventListener('blur', reset);
      }

      const replay = this.querySelector<HTMLButtonElement>('[data-replay]');
      if (replay) replay.hidden = false;
    }

    #play() {
      this.classList.remove('is-playing');
      // Force a style flush so the animation restarts from zero.
      void this.offsetWidth;
      this.classList.add('is-playing');
    }
  }

  function escape(value: string): string {
    return value.replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
  }

  customElements.define('page-trace', PageTraceElement);
</script>

<style>
  .trace {
    display: block;
    font-size: var(--text-sm);
  }

  .trace__head,
  .trace__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.125rem;
  }

  .trace__head {
    border-bottom: 1px solid var(--rule);
  }

  .trace__foot {
    align-items: center;
    border-top: 1px solid var(--rule);
  }

  .trace__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
  }

  .trace__total {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .trace__detail {
    color: var(--ink-2);
    font-size: var(--text-xs);
    min-height: 2.6em;
  }

  .trace__replay {
    flex: none;
    padding: 0.35rem 0.875rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .trace__replay:hover {
    border-color: var(--ink);
  }

  .trace__placeholder {
    padding: 1.5rem 1.125rem;
    color: var(--ink-2);
    min-height: 16rem;
  }

  :global(.trace__note) {
    padding: 0 1.125rem 0.875rem;
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  /* Rows share three columns: label, track, duration. */
  :global(.trace__grid) {
    --label-w: 11.5rem;
    --ms: 4.25rem;
    --pad: 1.125rem;
    --gap: 0.75rem;
    position: relative;
    padding: 2rem 0 2.25rem;
  }

  :global(.trace__axis),
  :global(.trace__marks) {
    position: absolute;
    inset: 0 calc(var(--ms) + var(--pad) + var(--gap)) 0 calc(var(--label-w) + var(--pad) + var(--gap));
    pointer-events: none;
  }

  :global(.trace__tick) {
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: var(--at);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    border-left: 1px dashed var(--rule);
    padding-left: 0.3rem;
    white-space: nowrap;
  }

  :global(.trace__rows) {
    position: relative;
    padding: 0;
    list-style: none;
  }

  :global(.trace__row) {
    display: grid;
    grid-template-columns: var(--label-w) minmax(0, 1fr) var(--ms);
    align-items: center;
    gap: var(--gap);
    width: 100%;
    padding: 0.3rem var(--pad);
    border: 0;
    background: none;
    text-align: left;
    cursor: default;
  }

  :global(.trace__row:hover),
  :global(.trace__row:focus-visible) {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  :global(.trace__row:focus-visible) {
    outline-offset: -2px;
  }

  :global(.trace__label) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
  }

  :global(.trace__row[data-depth='1'] .trace__label) {
    padding-left: 0.875rem;
    color: var(--ink-2);
  }

  :global(.trace__row[data-depth='0'] .trace__label) {
    font-weight: 600;
  }

  :global(.trace__track) {
    position: relative;
    height: 0.75rem;
  }

  :global(.trace__bar) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--left);
    width: max(var(--width), 2px);
    border-radius: 2px;
    background: var(--span-transfer);
    transform-origin: left center;
  }

  :global(.trace__row[data-kind='setup'] .trace__bar) {
    background: var(--span-setup);
  }

  :global(.trace__row[data-kind='server'] .trace__bar) {
    background: var(--span-server);
  }

  :global(.trace__row[data-kind='asset'] .trace__bar) {
    background: var(--span-asset);
  }

  :global(.trace__row[data-kind='render'] .trace__bar) {
    background: var(--span-render);
  }

  :global(.trace__row[data-depth='0'] .trace__bar) {
    background: var(--span-transfer);
    opacity: 0.85;
  }

  :global(.trace__ms) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-2);
    text-align: right;
    white-space: nowrap;
  }

  :global(.trace__mark) {
    position: absolute;
    top: 1.75rem;
    bottom: 0.25rem;
    left: var(--at);
    border-left: 1.5px solid var(--ink);
  }

  :global(.trace__mark-label) {
    position: absolute;
    bottom: -0.1rem;
    left: 0.35rem;
    padding: 0 0.3rem;
    background: var(--yellow);
    color: #1d2024;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(page-trace.is-playing .trace__bar) {
      animation: trace-grow var(--grow) var(--ease-out) var(--delay) both;
    }

    :global(page-trace.is-playing .trace__mark) {
      animation: trace-fade 200ms ease-out var(--delay) both;
    }
  }

  @keyframes trace-grow {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes trace-fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 40rem) {
    :global(.trace__grid) {
      --label-w: 8.25rem;
      --ms: 3.5rem;
      --pad: 0.75rem;
      --gap: 0.5rem;
    }

    :global(.trace__row) {
      font-size: var(--text-xs);
    }
  }
</style>

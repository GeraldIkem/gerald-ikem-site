---
import { site } from '~/data/site';
import { formatMonth } from '~/lib/timeline';
---

<footer class="site-footer wrap">
  <p>
    Designed and built by Gerald Ikem with Astro, TypeScript and hand-written CSS. No cookies, no trackers, and
    almost no JavaScript. <a href={`${site.links.github}`}>More of my code is on GitHub</a>.
  </p>
  <p>Updated {formatMonth(site.updated)}.</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .site-footer p:first-child {
    max-width: 40rem;
  }
</style>

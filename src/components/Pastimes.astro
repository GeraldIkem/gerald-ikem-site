---
/**
 * Sports and books, each with a small drawing that plays once when it comes
 * into view and again on hover: a jump shot, a ball rolled into the net, a
 * length of the pool, a book pulled off the shelf.
 */
const matchday = '/projects/matchday-ml/';
---

<pastime-cards class="pastimes">
  <article class="pastime pastime--court">
    <svg class="pastime__art" viewBox="0 0 320 170" aria-hidden="true">
      <rect class="court__wall" width="320" height="132" />
      <rect class="court__floor" y="132" width="320" height="38" />
      <rect class="court__paint" y="132" width="92" height="38" />
      <path class="court__boards" d="M0 144H320M0 157H320" />
      <path class="court__pole" d="M8 132V44h10" />
      <path class="court__board" d="M20 28v44" />
      <path class="court__rim" d="M21 64h26" />
      <path class="court__net" d="M23 64l5 17h12l5-17M28 64l5 17M40 64l-5 17" />
      <g class="ball-x">
        <g class="ball-y">
          <g class="court__ball">
            <circle cx="262" cy="121" r="11" />
            <path d="M251 121h22M262 110v22M254 113c5 5 5 11 0 16M270 113c-5 5-5 11 0 16" />
          </g>
        </g>
      </g>
    </svg>
    <div class="pastime__text">
      <h3>Basketball</h3>
      <p>I play, and I follow the NBA and the WNBA closely enough that both ended up in Matchday ML.</p>
      <p class="pastime__tags"><span>NBA</span><span>WNBA</span></p>
      <a class="pastime__link" href={matchday}>See how the forecasts work</a>
    </div>
  </article>

  <article class="pastime pastime--pitch">
    <svg class="pastime__art" viewBox="0 0 320 170" aria-hidden="true">
      <rect class="pitch__grass" width="320" height="170" />
      <g class="pitch__stripes">
        <rect x="0" width="40" height="170" />
        <rect x="80" width="40" height="170" />
        <rect x="160" width="40" height="170" />
        <rect x="240" width="40" height="170" />
      </g>
      <g class="pitch__lines">
        <rect x="10" y="10" width="300" height="150" />
        <path d="M160 10v150" />
        <circle cx="160" cy="85" r="26" />
        <path d="M10 45h40v80H10M310 45h-40v80h40" />
        <path d="M10 65h14v40H10M310 65h-14v40h14" />
      </g>
      <path class="pitch__goal" d="M310 70h8v30h-8" />
      <g class="roll">
        <g class="pitch__ball">
          <circle cx="160" cy="85" r="8" />
          <path d="M160 80l4 3-1.5 4.5h-5L156 83zM160 77v3M167 84l-3-1M165 91l-2-3.5M155 91l2-3.5M153 84l3-1" />
        </g>
      </g>
    </svg>
    <div class="pastime__text">
      <h3>Football</h3>
      <p>The Premier League, La Liga and the Champions League. The two leagues are in Matchday ML as well.</p>
      <p class="pastime__tags"><span>Premier League</span><span>La Liga</span><span>Champions League</span></p>
      <a class="pastime__link" href={matchday}>See how the forecasts work</a>
    </div>
  </article>

  <article class="pastime pastime--pool">
    <svg class="pastime__art" viewBox="0 0 320 170" aria-hidden="true">
      <rect class="pool__water" width="320" height="170" />
      <g class="pool__lanes">
        <path d="M0 22H320" />
        <path d="M0 64H320" />
        <path d="M0 106H320" />
        <path d="M0 148H320" />
      </g>
      <g class="pool__ropes">
        <path d="M0 43H320" />
        <path d="M0 85H320" />
        <path d="M0 127H320" />
      </g>
      <path class="pool__wall" d="M6 0v170M314 0v170" />
      <g class="swim">
        <g class="pool__swimmer">
          <path class="pool__wake" d="M8 100c6-3 10 3 16 0s10 3 16 0M14 110c6-3 10 3 16 0s10 3 16 0" />
          <circle cx="52" cy="106" r="6" />
          <path class="pool__arm" d="M46 101c6-12 18-12 22-2" />
        </g>
      </g>
    </svg>
    <div class="pastime__text">
      <h3>Swimming</h3>
      <p>The one sport here with no screen anywhere nearby.</p>
    </div>
  </article>

  <article class="pastime pastime--books">
    <svg class="pastime__art" viewBox="0 0 320 170" aria-hidden="true">
      <rect class="books__wall" width="320" height="170" />
      <path class="books__plank" d="M30 146H290" />
      <g class="books__row">
        <rect x="52" y="64" width="22" height="82" style="--b:var(--process-cyan)" />
        <rect x="76" y="54" width="16" height="92" style="--b:var(--ink)" />
        <rect x="94" y="72" width="26" height="74" style="--b:var(--process-magenta)" />
        <rect class="books__pick" x="122" y="48" width="20" height="98" style="--b:var(--process-yellow)" />
        <rect x="144" y="60" width="18" height="86" style="--b:var(--ink-2)" />
        <rect x="164" y="70" width="24" height="76" style="--b:var(--process-cyan)" />
        <rect x="190" y="58" width="14" height="88" style="--b:var(--process-magenta)" />
        <rect x="206" y="66" width="22" height="80" style="--b:var(--ink)" transform="rotate(14 228 146)" />
      </g>
    </svg>
    <div class="pastime__text">
      <h3>Books</h3>
      <p>Comics aren’t the only thing I collect. The bookshelf is filling up as well.</p>
    </div>
  </article>
</pastime-cards>

<script>
  class PastimeCards extends HTMLElement {
    connectedCallback() {
      if (!matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
      const cards = [...this.querySelectorAll<HTMLElement>('.pastime')];
      const play = (card: HTMLElement) => {
        if (card.classList.contains('is-playing')) return;
        card.classList.add('is-playing');
        card.addEventListener('animationend', () => card.classList.remove('is-playing'), { once: true });
      };
      // Each drawing plays once as it scrolls into view, then again on hover.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.unobserve(entry.target);
            play(entry.target as HTMLElement);
          }
        },
        { threshold: 0.7 },
      );
      for (const card of cards) {
        observer.observe(card);
        card.addEventListener('pointerenter', () => play(card));
      }
    }
  }
  customElements.define('pastime-cards', PastimeCards);
</script>

<style>
  .pastimes {
    --court: #e3b178;
    --court-line: #fff8ec;
    --grass: #3f9a4a;
    --grass-stripe: #48a853;
    --water: #29a3d8;
    --water-line: #136f9c;
    --wall: color-mix(in srgb, var(--paper) 70%, var(--rule));
    display: grid;
    gap: 1rem;
  }

  :global([data-theme='dark']) .pastimes {
    --court: #9b6a3a;
    --court-line: #f1dfc6;
    --grass: #24642c;
    --grass-stripe: #2b7234;
    --water: #11638b;
    --water-line: #0a3f5a;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .pastimes {
      --court: #9b6a3a;
      --court-line: #f1dfc6;
      --grass: #24642c;
      --grass-stripe: #2b7234;
      --water: #11638b;
      --water-line: #0a3f5a;
    }
  }

  @media (min-width: 44rem) {
    .pastimes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pastime {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--paper-raised);
  }

  .pastime__art {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--rule-strong);
  }

  .pastime__text {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1rem 1.125rem 1.125rem;
  }

  .pastime h3 {
    font-size: var(--text-md);
  }

  .pastime__text p {
    color: var(--ink-2);
  }

  .pastime__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }

  .pastime__tags span {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .pastime__link {
    justify-self: start;
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Court */
  .court__wall {
    fill: var(--wall);
  }

  .court__floor {
    fill: var(--court);
  }

  .court__paint {
    fill: color-mix(in srgb, #9c3d1c 40%, var(--court));
  }

  .court__boards {
    stroke: var(--court-line);
    stroke-width: 1;
    opacity: 0.35;
  }

  .court__pole {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 4;
  }

  .court__net {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.3;
  }

  .court__board {
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .court__rim {
    stroke: #e5532d;
    stroke-width: 4;
    stroke-linecap: round;
  }

  .court__ball circle {
    fill: #e8742a;
    stroke: #3b1d0c;
    stroke-width: 1.5;
  }

  .court__ball path {
    fill: none;
    stroke: #3b1d0c;
    stroke-width: 1.4;
  }

  /* A jump shot: across at a steady pace, up and down on a curve, through the net. */
  .is-playing .ball-x {
    animation: shot-x 1300ms linear;
  }

  .is-playing .ball-y {
    animation: shot-y 1300ms;
  }

  .is-playing .court__ball {
    animation: shot-spin 1300ms linear;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes shot-x {
    0% {
      transform: none;
    }
    70%,
    100% {
      transform: translateX(-229px);
    }
  }

  @keyframes shot-y {
    0% {
      transform: none;
      animation-timing-function: cubic-bezier(0.3, 0.6, 0.6, 1);
    }
    38% {
      transform: translateY(-108px);
      animation-timing-function: cubic-bezier(0.4, 0, 0.7, 0.4);
    }
    70% {
      transform: translateY(-65px);
      opacity: 1;
      animation-timing-function: ease-in;
    }
    88% {
      transform: translateY(-42px);
      opacity: 1;
    }
    100% {
      transform: translateY(-34px);
      opacity: 0;
    }
  }

  @keyframes shot-spin {
    to {
      transform: rotate(-360deg);
    }
  }

  /* Pitch */
  .pitch__grass {
    fill: var(--grass);
  }

  .pitch__stripes rect {
    fill: var(--grass-stripe);
  }

  .pitch__lines,
  .pitch__goal {
    fill: none;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: 2.5;
  }

  .pitch__goal {
    stroke-width: 3;
  }

  .pitch__ball circle {
    fill: #fff;
    stroke: #1d1d1d;
    stroke-width: 1.3;
  }

  .pitch__ball path {
    fill: #1d1d1d;
    stroke: #1d1d1d;
    stroke-width: 1;
  }

  .is-playing .roll {
    animation: roll 1400ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .is-playing .pitch__ball {
    animation: spin 1400ms cubic-bezier(0.2, 0.7, 0.3, 1);
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes roll {
    70% {
      transform: translateX(152px);
      opacity: 1;
    }
    85% {
      transform: translateX(152px);
      opacity: 1;
    }
    100% {
      transform: translateX(152px);
      opacity: 0;
    }
  }

  @keyframes spin {
    70%,
    100% {
      transform: rotate(720deg);
    }
  }

  /* Pool */
  .pool__water {
    fill: var(--water);
  }

  .pool__lanes {
    stroke: var(--water-line);
    stroke-width: 6;
    opacity: 0.55;
  }

  .pool__ropes {
    stroke: #fff;
    stroke-width: 4;
    stroke-dasharray: 6 6;
    stroke-linecap: round;
  }

  .pool__ropes path:nth-child(2) {
    stroke: #f2544a;
  }

  .pool__wall {
    stroke: rgb(255 255 255 / 0.7);
    stroke-width: 4;
  }

  .pool__swimmer circle {
    fill: #f2544a;
  }

  .pool__arm,
  .pool__wake {
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .pool__wake {
    stroke-width: 2;
    opacity: 0.8;
  }

  .is-playing .swim {
    animation: swim 2200ms ease-in-out;
  }

  .is-playing .pool__arm {
    animation: stroke 550ms linear 4;
    transform-box: fill-box;
    transform-origin: 30% 100%;
  }

  @keyframes swim {
    to {
      transform: translateX(244px);
    }
  }

  @keyframes stroke {
    50% {
      transform: scaleY(-1);
    }
  }

  /* Books */
  .books__wall {
    fill: var(--wall);
  }

  .books__plank {
    stroke: var(--ink-2);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .books__row rect {
    fill: var(--b);
    stroke: color-mix(in srgb, var(--ink) 35%, transparent);
    stroke-width: 1;
  }

  .is-playing .books__pick {
    animation: pull 1600ms var(--ease-out);
  }

  @keyframes pull {
    35%,
    70% {
      transform: translateY(-34px);
    }
  }

  @media print {
    .pastime__art {
      display: none;
    }
  }
</style>

---
/**
 * Sports and books, each a small drawing you can play: shoot a basket, take a
 * shot past the keeper, swim a length against the clock, pull a book off the
 * shelf. Each one plays itself once as it comes into view, then it's yours.
 * The physics and scoring live in src/lib/pastimes.ts.
 *
 * Each card is its own component in src/components/pastimes/, with its own
 * styles; the script that plays them all is src/scripts/pastimes.ts.
 */
import Court from './pastimes/Court.astro';
import Pitch from './pastimes/Pitch.astro';
import Pool from './pastimes/Pool.astro';
import Books from './pastimes/Books.astro';
---

<pastime-cards class="pastimes">
  <Court />
  <Pitch />
  <Pool />
  <Books />
</pastime-cards>

<script>
  import '~/scripts/pastimes';
</script>

<style>
  .pastimes {
    --court: #e3b178;
    --court-line: #fff8ec;
    --grass: #3f9a4a;
    --grass-stripe: #48a853;
    --water: #29a3d8;
    --water-line: #136f9c;
    --wall: color-mix(in srgb, var(--paper) 70%, var(--rule));
    display: grid;
    gap: 1rem;
  }

  :global([data-theme='dark']) .pastimes {
    --court: #9b6a3a;
    --court-line: #f1dfc6;
    --grass: #24642c;
    --grass-stripe: #2b7234;
    --water: #11638b;
    --water-line: #0a3f5a;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .pastimes {
      --court: #9b6a3a;
      --court-line: #f1dfc6;
      --grass: #24642c;
      --grass-stripe: #2b7234;
      --water: #11638b;
      --water-line: #0a3f5a;
    }
  }

  @media (min-width: 44rem) {
    .pastimes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Wide screens: all four in one row. */
  @media (min-width: 80rem) {
    .pastimes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

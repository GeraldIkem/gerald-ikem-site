---
/**
 * Each job and degree in its own card: who, when, what I did, and a picture
 * of the place or the work where there is one. The current job is wide and
 * carries the payment demo.
 */
import { Image } from 'astro:assets';
import { stints } from '~/data/career';
import { formatRange } from '~/lib/timeline';
import PayDemo from './PayDemo.astro';

const work = stints.filter((stint) => stint.track === 'work');
const study = stints.filter((stint) => stint.track === 'study');
const monogram = (org: string) =>
  org
    .replace(/[’']s\b/g, '')
    .split(/\s+/)
    .filter((word) => /^[A-Z]/.test(word))
    .map((word) => word[0])
    .join('')
    .slice(0, 2);
const groups = [
  { title: 'Jobs', items: work },
  { title: 'Education', items: study },
];
---

<div class="roles">
  {
    groups.map((group) => (
      <div class="roles__col">
        <h3 class="roles__group">{group.title}</h3>
        <div class="roles__grid">
          {group.items.map((stint) => (
            <article
              class:list={['rcard', { 'rcard--wide': stint.id === 'payaza' }]}
              id={stint.id}
              style={stint.brand ? `--org:${stint.brand.bg}` : undefined}
            >
              <header class="rcard__head">
                <span class:list={['rcard__logo', { 'rcard__logo--mark': !stint.logo }]} aria-hidden="true">
                  {stint.logo ? <Image src={stint.logo} alt="" width={96} height={96} /> : monogram(stint.org)}
                </span>
                <div>
                  <h4>{stint.track === 'work' ? stint.role : stint.org}</h4>
                  <p class="rcard__org">
                    {stint.track === 'work' ? stint.org : stint.role}
                    {stint.place && <>, {stint.place}</>}
                  </p>
                  <p class="rcard__when">{formatRange(stint)}</p>
                </div>
              </header>

              <div class="rcard__body">
                {stint.points.length > 0 && (
                  <ul class="rcard__points">
                    {stint.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
                {stint.shots && stint.shots.length > 0 && (
                  <ul class="rcard__shots">
                    {stint.shots.map((shot) => (
                      <li>
                        <figure>
                          <Image src={shot.image} alt={shot.alt} widths={[360, 720]} sizes="(min-width: 56rem) 18rem, 80vw" />
                          <figcaption>
                            {shot.href ? <a href={shot.href}>{shot.caption}</a> : shot.caption}
                          </figcaption>
                        </figure>
                      </li>
                    ))}
                  </ul>
                )}
                {stint.id === 'payaza' && <PayDemo />}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .roles {
    display: grid;
    gap: 2.5rem 1.5rem;
    margin-top: 3.5rem;
  }

  .roles__col {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
  }

  .roles__group {
    font-size: var(--text-md);
  }

  /* Wide screens: jobs and education side by side. */
  @media (min-width: 72rem) {
    .roles {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .roles__col:last-child .roles__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .roles__grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 56rem) {
    .roles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .rcard--wide {
      grid-column: 1 / -1;
    }

    .rcard--wide .rcard__body {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }

    .rcard--wide :global(.pay) {
      margin-top: 0;
    }
  }

  .rcard {
    --org: var(--ink);
    scroll-margin-top: calc(var(--header-h) + 1rem);
    padding: 1.125rem 1.25rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-top: 4px solid var(--org);
    border-radius: 8px;
    background: var(--paper-raised);
  }

  .rcard:target {
    box-shadow: 0 0 0 3px var(--process-yellow);
  }

  .rcard__head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .rcard__logo {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    padding: 0.5rem;
    border-radius: 8px;
    /* Logos are drawn for white, so they sit on white in both themes. */
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
  }

  .rcard__logo--mark {
    padding: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
  }

  .rcard__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rcard h4 {
    font-size: var(--text-md);
    line-height: 1.2;
  }

  .rcard__org {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .rcard__when {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .rcard__body {
    margin-top: 1rem;
  }

  .rcard__points {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.125rem;
    font-size: var(--text-sm);
  }

  .rcard__points li::marker {
    color: var(--ink-3);
  }

  :global([data-theme='dark']) .rcard {
    border-top-color: color-mix(in srgb, var(--org) 75%, #fff);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .rcard {
      border-top-color: color-mix(in srgb, var(--org) 75%, #fff);
    }
  }

  .rcard__shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .rcard__shots img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .rcard__shots figcaption {
    margin-top: 0.3rem;
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  @media print {
    .rcard {
      padding: 0;
      border: 0;
      break-inside: avoid;
    }

    .rcard__logo,
    .rcard__shots {
      display: none;
    }
  }
</style>

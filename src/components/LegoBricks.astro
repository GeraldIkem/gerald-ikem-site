---
import { legoSets } from '~/data/lego';

const built = legoSets.filter((set) => set.built);
const waiting = legoSets.filter((set) => !set.built);

// Wider names get longer bricks, like a 2×6 against a 2×3.
const studsFor = (name: string) => Math.min(Math.max(Math.ceil(name.length / 6), 3), 6);
---

<div class="lego">
  <div class="lego__group">
    <h3>Built <span class="lego__count">{built.length}</span></h3>
    <ul class="bricks">
      {
        built.map((set) => (
          <li class="brick" style={`--b:${set.color};--t:${set.text};--studs:${studsFor(set.name)}`}>
            <span class="brick__studs" aria-hidden="true">
              {Array.from({ length: studsFor(set.name) }, () => (
                <span />
              ))}
            </span>
            <span class="brick__face">
              <span class="brick__name">{set.name}</span>
              {set.note && <span class="brick__note">{set.note}</span>}
              {set.model && <span class="brick__badge">3D</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="lego__group">
    <h3>Still in the box <span class="lego__count">{waiting.length}</span></h3>
    <ul class="bricks bricks--waiting">
      {
        waiting.map((set) => (
          <li class="brick brick--waiting" style={`--b:${set.color};--t:${set.text};--studs:${studsFor(set.name)}`}>
            <span class="brick__studs" aria-hidden="true">
              {Array.from({ length: studsFor(set.name) }, () => (
                <span />
              ))}
            </span>
            <span class="brick__face">
              <span class="brick__name">{set.name}</span>
              {set.note && <span class="brick__note">{set.note}</span>}
              {set.model && <span class="brick__badge">3D</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lego {
    display: grid;
    gap: 2.25rem;
  }

  .lego__group h3 {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--text-md);
  }

  .lego__count {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .bricks {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.25rem 0.875rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .brick {
    --unit: 2.4rem;
    display: grid;
    width: calc(var(--studs) * var(--unit));
    transition: transform 220ms var(--ease-out);
  }

  .brick:hover {
    transform: translateY(-0.3rem) rotate(-1deg);
  }

  /* Studs: one per unit of width, each a short cylinder with a highlight. */
  .brick__studs {
    display: grid;
    grid-template-columns: repeat(var(--studs), 1fr);
    justify-items: center;
    height: 0.6rem;
  }

  .brick__studs span {
    width: 58%;
    height: 100%;
    border-radius: 3px 3px 0 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.28), transparent 45%, rgb(0 0 0 / 0.18)),
      var(--b);
  }

  .brick__face {
    display: grid;
    align-content: center;
    gap: 0.2rem;
    min-height: 4.75rem;
    padding: 0.7rem 0.8rem;
    border-radius: 3px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.18), transparent 30%, rgb(0 0 0 / 0.16)),
      var(--b);
    color: var(--t);
    box-shadow:
      inset 0 -4px 0 rgb(0 0 0 / 0.18),
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      0 1px 0 rgb(0 0 0 / 0.08);
  }

  .brick__name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 650;
    line-height: 1.15;
  }

  .brick__badge {
    justify-self: start;
    margin-top: 0.2rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .brick__note {
    font-size: 0.78rem;
    line-height: 1.25;
    opacity: 0.88;
  }

  /* Not built yet: the outline of the brick it will become. */
  .brick--waiting .brick__face {
    background: color-mix(in srgb, var(--b) 10%, transparent);
    border: 2px dashed var(--b);
    color: var(--ink);
    box-shadow: none;
  }

  .brick--waiting .brick__studs span {
    background: none;
    border: 2px dashed var(--b);
    border-bottom: 0;
  }

  /* Black and near-black bricks need a lighter edge on the dark theme. */
  :global([data-theme='dark']) .brick__face {
    box-shadow:
      inset 0 -4px 0 rgb(0 0 0 / 0.25),
      inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brick__face {
      box-shadow:
        inset 0 -4px 0 rgb(0 0 0 / 0.25),
        inset 0 0 0 1px rgb(255 255 255 / 0.16);
    }
  }

  :global([data-theme='dark']) .brick--waiting {
    --b-line: color-mix(in srgb, var(--b) 55%, white);
  }

  :global([data-theme='dark']) .brick--waiting .brick__face,
  :global([data-theme='dark']) .brick--waiting .brick__studs span {
    border-color: var(--b-line);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brick--waiting {
      --b-line: color-mix(in srgb, var(--b) 55%, white);
    }

    :global(:root:not([data-theme='light'])) .brick--waiting .brick__face,
    :global(:root:not([data-theme='light'])) .brick--waiting .brick__studs span {
      border-color: var(--b-line);
    }
  }

  @media (max-width: 40rem) {
    .brick {
      --unit: 2rem;
    }
  }
</style>

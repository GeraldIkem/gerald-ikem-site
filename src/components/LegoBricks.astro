---
/**
 * Every set as a brick with its official photo on the face. Built sets are
 * solid; the ones still in the box are drawn as an outline. A set with an
 * exact 3D model builds in the viewer when its brick is picked.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { legoSets, type LegoSet } from '~/data/lego';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/lego/*.webp', { eager: true });
const photoOf = (set: LegoSet) => (set.number ? photos[`../assets/lego/${set.number}.webp`]?.default : undefined);

const groups = [
  { title: 'Built', sets: legoSets.filter((set) => set.built), waiting: false },
  { title: 'Still in the box', sets: legoSets.filter((set) => !set.built), waiting: true },
];
---

<lego-bricks class="lego">
  {
    groups.map((group) => (
      <div class="lego__group">
        <h3>
          {group.title} <span class="lego__count">{group.sets.length}</span>
        </h3>
        <ul class="bricks">
          {group.sets.map((set) => {
            const photo = photoOf(set);
            const face = (
              <>
                <span class="brick__photo">
                  {photo && <Image src={photo} alt="" widths={[280, 560]} sizes="(min-width: 64rem) 10rem, 45vw" loading="lazy" />}
                </span>
                <span class="brick__label">
                  <span class="brick__name">{set.name}</span>
                  {set.note && <span class="brick__note">{set.note}</span>}
                  {set.model && <span class="brick__badge">{set.model.kind === 'scan' ? '3D scan' : '3D'}</span>}
                </span>
              </>
            );
            return (
              <li class:list={['brick', { 'brick--waiting': group.waiting }]} style={`--b:${set.color};--t:${set.text}`}>
                <span class="brick__studs" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                  <span />
                </span>
                {set.model ? (
                  <button type="button" class="brick__face" data-build={set.number} aria-label={set.model.kind === 'scan' ? `Show the scan of my ${set.name}` : `Build the ${set.name} in 3D`}>
                    {face}
                  </button>
                ) : (
                  <span class="brick__face">{face}</span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</lego-bricks>

<script>
  class LegoBricks extends HTMLElement {
    connectedCallback() {
      // A brick with a 3D model picks that set in the viewer, and brings the viewer into view.
      for (const brick of this.querySelectorAll<HTMLButtonElement>('[data-build]')) {
        brick.addEventListener('click', () => {
          const pick = document.querySelector<HTMLButtonElement>(`lego-viewer [data-number="${brick.dataset['build']}"]`);
          if (!pick) return;
          pick.click();
          const viewer = pick.closest('lego-viewer');
          const box = viewer?.getBoundingClientRect();
          if (viewer && box && (box.top < 0 || box.bottom > innerHeight)) {
            viewer.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          }
        });
      }
    }
  }
  customElements.define('lego-bricks', LegoBricks);
</script>

<style>
  .lego {
    display: grid;
    gap: 2rem;
  }

  .lego__group h3 {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--text-md);
  }

  .lego__count {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .bricks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.25rem 0.875rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .brick {
    display: grid;
    grid-template-rows: auto 1fr;
    transition: transform 220ms var(--ease-out);
  }

  .brick:hover {
    transform: translateY(-0.3rem) rotate(-1deg);
  }

  /* Four studs on top, like a 2×4. */
  .brick__studs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    justify-items: center;
    height: 0.6rem;
  }

  .brick__studs span {
    width: 58%;
    height: 100%;
    border-radius: 3px 3px 0 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.28), transparent 45%, rgb(0 0 0 / 0.18)),
      var(--b);
  }

  .brick__face {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.5rem;
    width: 100%;
    padding: 0.45rem 0.45rem 0.65rem;
    border: 0;
    border-radius: 3px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.18), transparent 30%, rgb(0 0 0 / 0.16)),
      var(--b);
    color: var(--t);
    font: inherit;
    text-align: left;
    box-shadow:
      inset 0 -4px 0 rgb(0 0 0 / 0.18),
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      0 1px 0 rgb(0 0 0 / 0.08);
  }

  button.brick__face {
    cursor: pointer;
  }

  button.brick__face:focus-visible {
    outline: 2px solid var(--magenta);
    outline-offset: 3px;
  }

  /* The set's official photo, on the white it was shot on, in both themes. */
  .brick__photo {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 2px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
  }

  .brick__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 300ms var(--ease-out);
  }

  .brick:hover .brick__photo :global(img) {
    transform: scale(1.04);
  }

  .brick__label {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding-inline: 0.3rem;
  }

  .brick__name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 650;
    line-height: 1.15;
  }

  .brick__badge {
    justify-self: start;
    margin-top: 0.2rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .brick__note {
    font-size: 0.78rem;
    line-height: 1.25;
    opacity: 0.88;
  }

  /* Not built yet: the outline of the brick it will become. */
  .brick--waiting .brick__face {
    background: color-mix(in srgb, var(--b) 10%, transparent);
    outline: 2px dashed var(--b);
    outline-offset: -2px;
    color: var(--ink);
    box-shadow: none;
  }

  .brick--waiting button.brick__face:focus-visible {
    outline: 2px solid var(--magenta);
    outline-offset: 3px;
  }

  .brick--waiting .brick__studs span {
    background: none;
    border: 2px dashed var(--b);
    border-bottom: 0;
  }

  /* Black and near-black bricks need a lighter edge on the dark theme. */
  :global([data-theme='dark']) .brick__face {
    box-shadow:
      inset 0 -4px 0 rgb(0 0 0 / 0.25),
      inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brick__face {
      box-shadow:
        inset 0 -4px 0 rgb(0 0 0 / 0.25),
        inset 0 0 0 1px rgb(255 255 255 / 0.16);
    }
  }

  :global([data-theme='dark']) .brick--waiting {
    --b-line: color-mix(in srgb, var(--b) 55%, white);
  }

  :global([data-theme='dark']) .brick--waiting .brick__face {
    outline-color: var(--b-line);
    box-shadow: none;
  }

  :global([data-theme='dark']) .brick--waiting .brick__studs span {
    border-color: var(--b-line);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brick--waiting {
      --b-line: color-mix(in srgb, var(--b) 55%, white);
    }

    :global(:root:not([data-theme='light'])) .brick--waiting .brick__face {
      outline-color: var(--b-line);
      box-shadow: none;
    }

    :global(:root:not([data-theme='light'])) .brick--waiting .brick__studs span {
      border-color: var(--b-line);
    }
  }

  @media (max-width: 40rem) {
    .bricks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brick:hover,
    .brick:hover .brick__photo :global(img) {
      transform: none;
    }
  }

  @media print {
    .brick__photo {
      display: none;
    }
  }
</style>

---
import { CURRENCIES } from '~/lib/payments';
---

<pay-demo class="pay panel">
  <div class="pay__intro">
    <h4 class="pay__title">Try paying twice</h4>
    <p>
      The same payment can reach a server twice: a client retries after a timeout, or someone taps Pay again. The
      checkout service refuses a reference it has already seen, so the customer is charged once. This is a small
      model of that check. It runs in your browser and no money moves.
    </p>
  </div>

  <form class="pay__form" method="dialog" data-form>
    <label class="pay__field">
      <span>Amount</span>
      <input name="amount" inputmode="decimal" autocomplete="off" value="2500.455" required />
    </label>
    <label class="pay__field">
      <span>Currency</span>
      <select name="currency">
        {CURRENCIES.map((code) => <option value={code} selected={code === 'ZAR'}>{code}</option>)}
      </select>
    </label>
    <p class="pay__field">
      <span>Payment reference</span>
      <code class="pay__ref" data-ref>PZ-7KQ2MX</code>
    </p>
    <div class="pay__actions">
      <button class="button" type="submit">Pay</button>
      <button class="button button--quiet" type="button" data-new>New payment</button>
    </div>
  </form>

  <ol class="pay__log" data-log aria-live="polite" aria-label="Requests sent"></ol>
  <p class="pay__summary" data-summary>No requests yet. Press Pay, then press it again.</p>
</pay-demo>

<script>
  import { Checkout, newReference, minorUnits, type Currency, type Step } from '~/lib/payments';

  const STEP_LABELS: Record<Step, string> = {
    validate: 'Validate',
    reference: 'Check reference',
    fee: 'Fee (cached)',
    charge: 'Charge',
    record: 'Record',
  };

  class PayDemo extends HTMLElement {
    #checkout = new Checkout();
    #requests = 0;

    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('[data-form]');
      const ref = this.querySelector<HTMLElement>('[data-ref]');
      if (!form || !ref) return;
      ref.textContent = newReference();

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const currency = String(data.get('currency')) as Currency;
        const result = this.#checkout.pay(ref.textContent ?? '', String(data.get('amount') ?? ''), currency);
        this.#requests += 1;
        this.#log(ref.textContent ?? '', currency, result);
      });

      this.querySelector('[data-new]')?.addEventListener('click', () => {
        ref.textContent = newReference();
        this.#summary(`New reference ${ref.textContent}. The next Pay is a new payment.`);
      });
    }

    #log(reference: string, currency: Currency, result: ReturnType<Checkout['pay']>) {
      const log = this.querySelector<HTMLOListElement>('[data-log]');
      if (!log) return;
      const item = document.createElement('li');
      item.className = 'pay__entry';
      item.dataset['status'] = String(result.status);

      const line = document.createElement('p');
      line.className = 'pay__line';
      const request = document.createElement('code');
      request.textContent = `POST /checkout ${reference}`;
      const status = document.createElement('strong');
      status.textContent = String(result.status);
      const message = document.createElement('span');
      const digits = minorUnits(currency);
      message.textContent =
        result.status === 201
          ? `${result.message} ${currency} rounds to ${digits === 0 ? 'whole units' : `${digits} decimal places`}.`
          : result.message;
      line.append(status, request, message);

      const steps = document.createElement('ol');
      steps.className = 'pay__steps';
      result.steps.forEach((step, index) => {
        const li = document.createElement('li');
        li.textContent = STEP_LABELS[step];
        const failed = result.status !== 201 && index === result.steps.length - 1;
        li.dataset['state'] = failed ? 'failed' : 'ok';
        steps.append(li);
      });

      item.append(line, steps);
      log.prepend(item);
      while (log.children.length > 4) log.lastElementChild?.remove();

      const charges = this.#checkout.charges;
      this.#summary(
        `${this.#requests} ${this.#requests === 1 ? 'request' : 'requests'}, ${charges} ${charges === 1 ? 'charge' : 'charges'}.`,
      );
    }

    #summary(text: string) {
      const summary = this.querySelector('[data-summary]');
      if (summary) summary.textContent = text;
    }
  }

  customElements.define('pay-demo', PayDemo);
</script>

<style>
  .pay {
    display: block;
    margin-top: 1.75rem;
    padding: 1.25rem 1.25rem 1rem;
    font-size: var(--text-sm);
  }

  .pay__title {
    font-size: var(--text-base);
  }

  .pay__intro p {
    margin-top: 0.375rem;
    color: var(--ink-2);
    max-width: 40rem;
  }

  .pay__form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.875rem 1.25rem;
    margin-top: 1.125rem;
  }

  .pay__field {
    display: grid;
    gap: 0.25rem;
  }

  .pay__field > span {
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .pay__field input,
  .pay__field select {
    min-height: 2.75rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .pay__field input {
    width: 9rem;
    font-family: var(--font-mono);
  }

  .pay__ref {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius);
  }

  .pay__actions {
    display: flex;
    gap: 0.5rem;
  }

  .pay__log {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.125rem;
    padding: 0;
    list-style: none;
  }

  .pay__log:empty {
    display: none;
  }

  :global(.pay__entry) {
    padding: 0.625rem 0.75rem;
    border-left: 3px solid var(--cyan);
    background: var(--paper);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  :global(.pay__entry[data-status='409']),
  :global(.pay__entry[data-status='400']) {
    border-left-color: var(--magenta);
  }

  :global(.pay__line) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }

  :global(.pay__line strong) {
    font-family: var(--font-mono);
  }

  :global(.pay__line code) {
    color: var(--ink-2);
  }

  :global(.pay__steps) {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  :global(.pay__steps li) {
    padding: 0.1rem 0.5rem;
    border-radius: 2px;
    background: color-mix(in srgb, var(--cyan) 18%, transparent);
    box-shadow: inset 0 -2px 0 var(--cyan);
  }

  :global(.pay__steps li[data-state='failed']) {
    background: color-mix(in srgb, var(--magenta) 16%, transparent);
    box-shadow: inset 0 -2px 0 var(--magenta);
  }

  .pay__summary {
    margin-top: 0.875rem;
    color: var(--ink-2);
    font-size: var(--text-xs);
  }
</style>

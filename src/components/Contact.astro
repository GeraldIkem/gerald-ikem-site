---
import { site } from '~/data/site';
---

<div class="contact">
  <p class="contact__lead">The quickest way to reach me is email.</p>
  <div class="contact__email">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <button type="button" class="button button--quiet contact__copy" data-copy={site.email} hidden>Copy address</button>
  </div>
  <ul class="contact__links">
    <li><a href={site.links.linkedin}>LinkedIn</a></li>
    <li><a href={site.links.github}>GitHub</a></li>
    <li><a href={site.resume} download>Résumé (PDF)</a></li>
  </ul>
  <p class="contact__note">
    Based in {site.location}, near Toronto. Authorized to work in Canada and the United States.
  </p>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    const label = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset['copy'] ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed. Select the address instead.';
      }
      setTimeout(() => (button.textContent = label), 2200);
    });
  }
</script>

<style>
  .contact__lead {
    color: var(--ink-2);
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  .contact__email a {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--ink);
    text-decoration-thickness: 2px;
    text-decoration-color: var(--cyan);
    text-underline-offset: 0.15em;
    overflow-wrap: anywhere;
  }

  .contact__email a:hover {
    text-decoration-color: var(--magenta);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.75rem;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .contact__note {
    margin-top: 1.25rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
</style>

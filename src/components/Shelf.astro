---
import { getCollection } from 'astro:content';
import { STATUS_LABEL, countBy, describe, shelfOrder, spineStyle, type Book, type Status } from '~/lib/shelf';

interface Props {
  /** A single, non-interactive row for the home page. */
  teaser?: boolean;
}

const { teaser = false } = Astro.props;
const entries = await getCollection('comics');
const all: Book[] = entries.map((entry) => ({ ...entry.data, id: entry.id })).sort(shelfOrder);
const counts = countBy(all);
const books = teaser ? all.filter((book) => book.status === 'shelf') : all;
const defaultShown: Status[] = ['shelf', 'ordered'];
const filters: Status[] = ['shelf', 'ordered', 'wishlist', 'read'];
---

{
  teaser ? (
    <div class="shelf shelf--teaser" aria-hidden="true">
      <div class="shelf__books">
        {books.map((book) => {
          const style = spineStyle(book);
          return (
            <span class="spine" data-status={book.status} style={`--h:${style.height}rem;--w:${style.width}rem;--c:${style.color}`}>
              <span class="spine__body">
                <span class="spine__title">{book.title}</span>
              </span>
            </span>
          );
        })}
      </div>
    </div>
  ) : (
    <comic-shelf class="shelf">
      <div class="shelf__filters" role="group" aria-label="Show books">
        {filters.map((status) => (
          <button type="button" class="shelf__filter" data-filter={status} data-status={status} aria-pressed={defaultShown.includes(status) ? 'true' : 'false'}>
            {STATUS_LABEL[status]} <span class="shelf__count">{counts[status]}</span>
          </button>
        ))}
      </div>

      <div class="shelf__books" role="listbox" aria-label="Comics" aria-orientation="horizontal">
        {books.map((book, index) => {
          const style = spineStyle(book);
          return (
            <button
              type="button"
              class="spine"
              role="option"
              aria-selected="false"
              tabindex={index === 0 ? 0 : -1}
              hidden={!defaultShown.includes(book.status)}
              data-id={book.id}
              data-status={book.status}
              data-title={book.title}
              data-meta={describe(book)}
              data-state={STATUS_LABEL[book.status]}
              data-note={book.note}
              style={`--h:${style.height}rem;--w:${style.width}rem;--c:${style.color}`}
              aria-label={`${book.title}. ${STATUS_LABEL[book.status]}.`}
            >
              <span class="spine__body">
                <span class="spine__title">{book.title}</span>
              </span>
            </button>
          );
        })}
      </div>

      <div class="shelf__detail" aria-live="polite" data-detail>
        <p class="shelf__hint">Pick a book to pull it off the shelf and read my note on it.</p>
      </div>
    </comic-shelf>
  )
}

<script>
  class ComicShelf extends HTMLElement {
    #spines: HTMLButtonElement[] = [];

    connectedCallback() {
      this.#spines = [...this.querySelectorAll<HTMLButtonElement>('.spine')];
      for (const filter of this.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
        filter.addEventListener('click', () => this.#toggle(filter));
      }
      for (const spine of this.#spines) {
        spine.addEventListener('click', () => this.#select(spine));
      }
      this.querySelector('.shelf__books')?.addEventListener('keydown', (event) => this.#onKey(event as KeyboardEvent));
      this.#applyFilters();
    }

    #visible(): HTMLButtonElement[] {
      return this.#spines.filter((spine) => !spine.hidden);
    }

    #toggle(filter: HTMLButtonElement) {
      const pressed = filter.getAttribute('aria-pressed') === 'true';
      const others = [...this.querySelectorAll('[data-filter][aria-pressed="true"]')].length;
      // Keep at least one filter on, so the shelf is never empty by accident.
      if (pressed && others === 1) return;
      filter.setAttribute('aria-pressed', String(!pressed));
      this.#applyFilters();
    }

    #applyFilters() {
      const shown = new Set(
        [...this.querySelectorAll<HTMLElement>('[data-filter][aria-pressed="true"]')].map((el) => el.dataset['filter']),
      );
      for (const spine of this.#spines) spine.hidden = !shown.has(spine.dataset['status']);
      const visible = this.#visible();
      if (!visible.some((spine) => spine.tabIndex === 0)) {
        for (const spine of this.#spines) spine.tabIndex = -1;
        if (visible[0]) visible[0].tabIndex = 0;
      }
      const selected = this.#spines.find((spine) => spine.getAttribute('aria-selected') === 'true');
      if (selected?.hidden) this.#clear();
    }

    #onKey(event: KeyboardEvent) {
      const visible = this.#visible();
      const current = visible.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;
      let next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = Math.min(current + 1, visible.length - 1);
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = Math.max(current - 1, 0);
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = visible.length - 1;
      else return;
      event.preventDefault();
      const target = visible[next];
      if (!target) return;
      for (const spine of visible) spine.tabIndex = -1;
      target.tabIndex = 0;
      target.focus();
    }

    #select(spine: HTMLButtonElement) {
      const already = spine.getAttribute('aria-selected') === 'true';
      for (const other of this.#spines) other.setAttribute('aria-selected', 'false');
      if (already) {
        this.#clear();
        return;
      }
      spine.setAttribute('aria-selected', 'true');
      for (const other of this.#spines) other.tabIndex = -1;
      spine.tabIndex = 0;

      const detail = this.querySelector<HTMLElement>('[data-detail]');
      if (!detail) return;
      detail.replaceChildren();
      const title = document.createElement('h3');
      title.textContent = spine.dataset['title'] ?? '';
      const meta = document.createElement('p');
      meta.className = 'shelf__meta';
      meta.textContent = `${spine.dataset['state']}. ${spine.dataset['meta']}.`;
      detail.append(title, meta);
      if (spine.dataset['note']) {
        const note = document.createElement('p');
        note.className = 'shelf__note';
        note.textContent = spine.dataset['note'];
        detail.append(note);
      }
    }

    #clear() {
      const detail = this.querySelector<HTMLElement>('[data-detail]');
      if (!detail) return;
      const hint = document.createElement('p');
      hint.className = 'shelf__hint';
      hint.textContent = 'Pick a book to pull it off the shelf and read my note on it.';
      detail.replaceChildren(hint);
    }
  }

  customElements.define('comic-shelf', ComicShelf);
</script>

<style>
  .shelf {
    --row: 15rem;
    --gap: 1.75rem;
    --board: var(--rule-strong);
    display: block;
  }

  .shelf__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
  }

  .shelf__filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .shelf__filter[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .shelf__count {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  /*
   * Every spine sits in a box of the same height, so wrapped lines line up
   * and a shelf board can be drawn under each one.
   */
  .shelf__books {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--gap) 0;
    padding: 0 0.5rem;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 var(--row),
      var(--board) var(--row) calc(var(--row) + 5px),
      transparent calc(var(--row) + 5px) calc(var(--row) + var(--gap))
    );
  }

  .spine {
    display: flex;
    align-items: flex-end;
    height: var(--row);
    margin: 0 1px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
  }

  .spine[hidden] {
    display: none;
  }

  .spine__body {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--w);
    height: var(--h);
    padding: 0.5rem 0;
    overflow: hidden;
    border-radius: 2px 2px 0 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.1), transparent 22%, transparent 78%, rgb(0 0 0 / 0.18)),
      var(--c);
    transition: transform 260ms var(--ease-out);
  }

  .spine__title {
    max-height: 100%;
    overflow: hidden;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .spine[data-status='ordered'] .spine__body {
    background:
      repeating-linear-gradient(135deg, var(--c) 0 3px, transparent 3px 7px),
      color-mix(in oklch, var(--c) 30%, var(--paper));
    color: var(--ink);
  }

  /* A paper sticker keeps the title readable over the stripes. */
  .spine[data-status='ordered'] .spine__title {
    padding: 0.3rem 0.1rem;
    border-radius: 1px;
    background: var(--paper-raised);
  }

  .spine[data-status='wishlist'] .spine__body {
    background: none;
    outline: 1.5px dashed color-mix(in oklch, var(--c) 70%, var(--ink));
    outline-offset: -1.5px;
    color: var(--ink-2);
  }

  .spine[data-status='read'] .spine__body {
    opacity: 0.45;
  }

  button.spine {
    cursor: pointer;
  }

  button.spine:hover .spine__body {
    transform: translateY(-0.3rem);
  }

  button.spine[aria-selected='true'] .spine__body {
    transform: translateY(-1rem);
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--ink);
  }

  button.spine:focus-visible {
    outline: none;
  }

  button.spine:focus-visible .spine__body {
    outline: 2px solid var(--magenta);
    outline-offset: 2px;
  }

  .shelf__detail {
    min-height: 9rem;
    margin-top: 1.5rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--paper-raised);
  }

  .shelf__hint {
    color: var(--ink-2);
  }

  .shelf__detail :global(h3) {
    font-size: var(--text-md);
  }

  .shelf__detail :global(.shelf__meta) {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .shelf__detail :global(.shelf__note) {
    margin-top: 0.75rem;
    max-width: var(--measure);
  }

  /* Home page: one shelf, cut off at the edge like the rest of the room. */
  .shelf--teaser .shelf__books {
    flex-wrap: nowrap;
    overflow: hidden;
    mask-image: linear-gradient(to right, #000 75%, transparent);
    height: calc(var(--row) + 5px);
  }

  @media (max-width: 40rem) {
    .shelf {
      --row: 11rem;
      --gap: 1.25rem;
    }

    .spine__body {
      height: calc(var(--h) * 0.72);
      width: calc(var(--w) * 0.8);
    }

    .spine__title {
      font-size: 0.6rem;
    }
  }
</style>

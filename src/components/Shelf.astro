---
import { getCollection } from 'astro:content';
import Spine from './Spine.astro';
import rewrittenNotes from '~/data/comic-notes.json';
import {
  STATUS_LABEL,
  countBy,
  describe,
  publisherMark,
  shelfOrder,
  spineLabel,
  spineStyle,
  type Book,
  type Status,
} from '~/lib/shelf';

interface Props {
  /** A single, non-interactive row for the home page. */
  teaser?: boolean;
}

const { teaser = false } = Astro.props;
// Notes I've rewritten win over the ones that come in with the CLZ export.
const notes = rewrittenNotes as Record<string, string>;
const noteFor = (book: Book) => notes[book.id] ?? book.note;
const entries = await getCollection('comics');
const all: Book[] = entries.map((entry) => ({ ...entry.data, id: entry.id })).sort(shelfOrder);
const counts = countBy(all);
const owned = all.filter((book) => book.status === 'shelf');
// The home page shows one shelf, so mix publishers there for a truer picture.
const mixed = (() => {
  const dc = owned.filter((book) => book.publisher === 'DC Comics');
  const others = owned.filter((book) => book.publisher !== 'DC Comics');
  const out: Book[] = [];
  while (dc.length || others.length) {
    const fromDc = dc.splice(0, 2);
    const fromOthers = others.splice(0, 1);
    out.push(...fromDc, ...fromOthers);
  }
  return out;
})();
const books = teaser ? mixed : all;
const defaultShown: Status[] = ['shelf', 'ordered'];
const filters: Status[] = ['shelf', 'ordered', 'wishlist', 'read'];
---

{
  teaser ? (
    <div class="shelf shelf--teaser" aria-hidden="true">
      <div class="shelf__books">
        {books.map((book) => {
          const style = spineStyle(book);
          return (
            <span class="spine" data-status={book.status} style={`--h:${style.height}rem;--w:${style.width}rem;--c:${style.color};--tc:${style.text}`}>
              <Spine book={book} />
            </span>
          );
        })}
      </div>
    </div>
  ) : (
    <comic-shelf class="shelf">
      <div class="shelf__filters" role="group" aria-label="Show books">
        {filters.map((status) => (
          <button
            type="button"
            class="shelf__filter"
            data-filter={status}
            data-status={status}
            aria-pressed={defaultShown.includes(status) ? 'true' : 'false'}
          >
            {STATUS_LABEL[status]} <span class="shelf__count">{counts[status]}</span>
          </button>
        ))}
      </div>

      <div class="shelf__books" role="listbox" aria-label="Comics" aria-orientation="horizontal">
        {books.map((book, index) => {
          const style = spineStyle(book);
          const { label, volume } = spineLabel(book.title);
          return (
            <button
              type="button"
              class="spine"
              role="option"
              aria-selected="false"
              tabindex={index === 0 ? 0 : -1}
              hidden={!defaultShown.includes(book.status)}
              data-id={book.id}
              data-status={book.status}
              data-title={book.title}
              data-label={label}
              data-volume={volume ?? ''}
              data-publisher={publisherMark(book.publisher)}
              data-format={book.format}
              data-meta={describe(book)}
              data-state={STATUS_LABEL[book.status]}
              data-note={noteFor(book)}
              data-h={style.height}
              data-w={style.width}
              data-cover={book.cover ?? ''}
              data-spine-image={book.spineImage ?? ''}
              data-back-image={book.backImage ?? ''}
              data-ratio={book.coverRatio ?? 0.67}
              style={`--h:${style.height}rem;--w:${style.width}rem;--c:${style.color};--tc:${style.text}`}
              aria-label={`${book.title}. ${STATUS_LABEL[book.status]}.`}
            >
              <Spine book={book} />
            </button>
          );
        })}
      </div>

      <div class="shelf__detail">
        <div class="shelf__stage" data-stage aria-hidden="true"></div>
        <div class="shelf__text">
          <div aria-live="polite" data-text>
            <p class="shelf__hint">Pick a book to pull it off the shelf and read my note on it.</p>
          </div>
          <button type="button" class="shelf__random" data-random>Pull one at random</button>
          <p class="shelf__tip">Drag the book to turn it.</p>
        </div>
      </div>
    </comic-shelf>
  )
}

<script>
  import type { BookStage } from '~/scripts/book3d';

  const motionOk = () => matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const RESTING_ANGLE = 24;

  class ComicShelf extends HTMLElement {
    #spines: HTMLButtonElement[] = [];
    #angle = RESTING_ANGLE;
    #engine: BookStage | null = null;
    #selected: HTMLButtonElement | null = null;

    connectedCallback() {
      this.#spines = [...this.querySelectorAll<HTMLButtonElement>('.spine')];
      for (const filter of this.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
        filter.addEventListener('click', () => this.#toggle(filter));
      }
      for (const spine of this.#spines) {
        spine.addEventListener('click', () => this.#select(spine));
      }
      this.querySelector('.shelf__books')?.addEventListener('keydown', (event) => this.#onKey(event as KeyboardEvent));
      this.querySelector('[data-random]')?.addEventListener('click', () => this.#random(true));
      this.#enableDrag();
      this.#applyFilters();
      // Start with a book already off the shelf, so the stage is never empty.
      this.#random(false);

      // Swap the quick CSS book for the full three.js hardcover once the shelf is in view.
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.some((entry) => entry.isIntersecting);
          this.#engine?.setVisible(visible);
          if (visible) void this.#loadEngine();
        },
        { rootMargin: '300px 0px' },
      );
      observer.observe(this);
    }

    #engineLoading: Promise<void> | null = null;

    #loadEngine(): Promise<void> {
      this.#engineLoading ??= (async () => {
        const stage = this.querySelector<HTMLElement>('[data-stage]');
        if (!stage) return;
        try {
          const { BookStage } = await import('~/scripts/book3d');
          stage.replaceChildren();
          stage.classList.add('is-3d');
          this.#engine = new BookStage(stage, {
            reducedMotion: !motionOk(),
            interactive: true,
          });
          if (this.#selected) this.#stage(this.#selected);
        } catch {
          // No WebGL: the CSS book stays.
        }
      })();
      return this.#engineLoading;
    }

    #visible(): HTMLButtonElement[] {
      return this.#spines.filter((spine) => !spine.hidden);
    }

    #random(focus: boolean) {
      const owned = this.#visible().filter((spine) => spine.dataset['status'] === 'shelf');
      const pool = owned.length ? owned : this.#visible();
      const current = this.#spines.find((spine) => spine.getAttribute('aria-selected') === 'true');
      const choices = pool.filter((spine) => spine !== current);
      const pick = choices[Math.floor(Math.random() * choices.length)];
      if (!pick) return;
      this.#select(pick, { toggle: false });
      if (focus) pick.focus({ preventScroll: true });
    }

    #toggle(filter: HTMLButtonElement) {
      const pressed = filter.getAttribute('aria-pressed') === 'true';
      const on = this.querySelectorAll('[data-filter][aria-pressed="true"]').length;
      // Keep at least one filter on, so the shelf is never empty by accident.
      if (pressed && on === 1) return;
      filter.setAttribute('aria-pressed', String(!pressed));
      this.#applyFilters();
    }

    #applyFilters() {
      const shown = new Set(
        [...this.querySelectorAll<HTMLElement>('[data-filter][aria-pressed="true"]')].map((el) => el.dataset['filter']),
      );
      for (const spine of this.#spines) spine.hidden = !shown.has(spine.dataset['status']);
      const visible = this.#visible();
      if (!visible.some((spine) => spine.tabIndex === 0)) {
        for (const spine of this.#spines) spine.tabIndex = -1;
        if (visible[0]) visible[0].tabIndex = 0;
      }
    }

    #onKey(event: KeyboardEvent) {
      const visible = this.#visible();
      const current = visible.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;
      let next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = Math.min(current + 1, visible.length - 1);
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = Math.max(current - 1, 0);
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = visible.length - 1;
      else return;
      event.preventDefault();
      const target = visible[next];
      if (!target) return;
      for (const spine of visible) spine.tabIndex = -1;
      target.tabIndex = 0;
      target.focus();
    }

    #select(spine: HTMLButtonElement, { toggle = true } = {}) {
      if (toggle && spine.getAttribute('aria-selected') === 'true') return;
      for (const other of this.#spines) {
        other.setAttribute('aria-selected', 'false');
        other.tabIndex = -1;
      }
      spine.setAttribute('aria-selected', 'true');
      spine.tabIndex = 0;
      this.#describe(spine);
      this.#stage(spine);
    }

    #describe(spine: HTMLButtonElement) {
      const text = this.querySelector<HTMLElement>('[data-text]');
      if (!text) return;
      const title = document.createElement('h3');
      title.textContent = spine.dataset['title'] ?? '';
      const meta = document.createElement('p');
      meta.className = 'shelf__meta';
      meta.textContent = `${spine.dataset['state']}. ${spine.dataset['meta']}.`;
      text.replaceChildren(title, meta);
      if (spine.dataset['note']) {
        const note = document.createElement('p');
        note.className = 'shelf__note';
        note.textContent = spine.dataset['note'];
        text.append(note);
      }
    }

    /** Build a 3D copy of the book: front cover, spine, page edges and back. */
    #stage(spine: HTMLButtonElement) {
      this.#selected = spine;
      const stage = this.querySelector<HTMLElement>('[data-stage]');
      if (!stage) return;
      const data = spine.dataset;
      if (this.#engine && data['cover']) {
        void this.#engine.show({
          front: data['cover'],
          spine: data['spineImage'] || undefined,
          back: data['backImage'] || undefined,
          ratio: Number(data['ratio'] || 0.67),
          depth: Number(data['w']) / Number(data['h']),
          color: spine.style.getPropertyValue('--c').trim() || '#333333',
          title: data['label'] || data['title'] || '',
          publisher: data['publisher'] || '',
          textColor: spine.style.getPropertyValue('--tc').trim() || '#ffffff',
        });
        return;
      }
      // Shown a little larger than on the shelf, so the cover reads.
      const height = Number(data['h']) * 1.22;
      const thickness = Math.max(Number(data['w']) * 1.1, 1);
      const book = document.createElement('div');
      book.className = 'book3d';
      book.dataset['status'] = data['status'] ?? 'shelf';
      book.style.setProperty('--c', spine.style.getPropertyValue('--c'));
      book.style.setProperty('--tc', spine.style.getPropertyValue('--tc'));
      book.style.setProperty('--bh', `${height}rem`);
      book.style.setProperty('--bw', `${height * Number(data['ratio'] || 0.67)}rem`);
      book.style.setProperty('--bt', `${thickness}rem`);

      const inner = document.createElement('div');
      inner.className = 'book3d__inner';

      const front = data['cover'] ? this.#realCover(data) : this.#printedCover(data);
      if (data['status'] !== 'shelf') front.append(part('span', 'cover__sticker', data['state']));

      const spineFace = document.createElement('div');
      spineFace.className = 'book3d__spine';
      const body = spine.querySelector('.spine__body');
      if (body) spineFace.append(body.cloneNode(true));

      const back = part('div', 'book3d__back', [part('span', 'book3d__exlibris', 'From the shelf of Gerald Ikem')]);
      inner.append(front, spineFace, part('div', 'book3d__pages'), part('div', 'book3d__top'), back);
      book.append(inner);
      stage.replaceChildren(book);

      // Turn from spine-on to cover-on: the book coming off the shelf.
      if (motionOk()) {
        this.#setAngle(book, 88, false);
        requestAnimationFrame(() => requestAnimationFrame(() => this.#setAngle(book, RESTING_ANGLE, true)));
      } else {
        this.#setAngle(book, RESTING_ANGLE, false);
      }
    }

    /** The publisher's front cover, wrapped onto the board with a little gloss. */
    #realCover(data: DOMStringMap): HTMLElement {
      const front = document.createElement('div');
      front.className = 'book3d__front cover cover--real';
      const img = document.createElement('img');
      img.src = data['cover'] ?? '';
      img.alt = '';
      img.decoding = 'async';
      img.draggable = false;
      front.append(img, part('span', 'cover__gloss'));
      return front;
    }

    /** A stand-in cover for any book without artwork. */
    #printedCover(data: DOMStringMap): HTMLElement {
      const front = document.createElement('div');
      front.className = 'book3d__front cover';
      const label = data['label'] ?? '';
      const size = label.length <= 14 ? 1.7 : label.length <= 24 ? 1.35 : label.length <= 36 ? 1.12 : 0.95;
      front.style.setProperty('--fs', `${size}rem`);
      front.append(
        part('span', 'cover__dots'),
        part('span', 'cover__band'),
        part('span', 'cover__top', [part('span', 'cover__pub', data['publisher']), part('span', 'cover__format', data['format'])]),
      );
      if (data['volume']) front.append(part('span', 'cover__vol', data['volume']));
      front.append(part('span', 'cover__title', label), part('span', 'cover__foot', 'From the shelf of Gerald Ikem'));
      return front;
    }

    #setAngle(book: HTMLElement, angle: number, animate: boolean) {
      this.#angle = angle;
      book.classList.toggle('is-turning', animate);
      book.style.setProperty('--ry', `${angle}deg`);
    }

    #enableDrag() {
      const stage = this.querySelector<HTMLElement>('[data-stage]');
      if (!stage) return;
      let startX = 0;
      // The three.js stage has its own orbit controls; this drag is for the CSS book.
      let startAngle = 0;
      let dragging = false;
      stage.addEventListener('pointerdown', (event) => {
        if (this.#engine) return;
        const book = stage.querySelector<HTMLElement>('.book3d');
        if (!book) return;
        dragging = true;
        startX = event.clientX;
        startAngle = this.#angle;
        stage.setPointerCapture(event.pointerId);
        book.classList.remove('is-turning');
      });
      stage.addEventListener('pointermove', (event) => {
        const book = stage.querySelector<HTMLElement>('.book3d');
        if (!dragging || !book) return;
        this.#setAngle(book, startAngle + (event.clientX - startX) * 0.6, false);
      });
      const stop = () => {
        dragging = false;
      };
      stage.addEventListener('pointerup', stop);
      stage.addEventListener('pointercancel', stop);
    }
  }

  function part(tag: string, className: string, content?: string | Node[]): HTMLElement {
    const el = document.createElement(tag);
    el.className = className;
    if (typeof content === 'string') el.textContent = content;
    else if (content) el.append(...content);
    return el;
  }

  customElements.define('comic-shelf', ComicShelf);
</script>

<style>
  .shelf {
    --row: 15rem;
    --gap: 1.75rem;
    --board: var(--rule-strong);
    display: block;
  }

  .shelf__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
  }

  .shelf__filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .shelf__filter[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .shelf__count {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  /*
   * Every spine sits in a box of the same height, so wrapped lines line up
   * and a shelf board can be drawn under each one.
   */
  .shelf__books {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--gap) 0;
    padding: 0 0.5rem;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 var(--row),
      var(--board) var(--row) calc(var(--row) + 6px),
      transparent calc(var(--row) + 6px) calc(var(--row) + var(--gap))
    );
  }

  .spine {
    display: flex;
    align-items: flex-end;
    height: var(--row);
    margin: 0 1px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
  }

  .spine[hidden] {
    display: none;
  }

  :global(.spine__body) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: var(--w);
    height: var(--h);
    padding: 0.45rem 0 0;
    overflow: hidden;
    border-radius: 2px 2px 0 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.14), transparent 24%, transparent 76%, rgb(0 0 0 / 0.22)),
      var(--c);
    color: var(--tc, #fff);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.14);
    transition: transform 260ms var(--ease-out);
  }

  /* Foil bands near the head of the spine, like a bound omnibus. */
  :global(.spine__body)::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    left: 0;
    right: 0;
    height: 2px;
    background: rgb(255 214 130 / 0.7);
    box-shadow: 0 5px 0 rgb(255 214 130 / 0.45);
  }

  :global(.spine__vol) {
    flex: none;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
    color: inherit;
  }

  :global(.spine__title) {
    flex: 1;
    min-height: 0;
    margin-top: 0.35rem;
    overflow: hidden;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  :global(.spine__foot) {
    flex: none;
    width: 100%;
    padding: 0.45rem 0;
    background: rgb(0 0 0 / 0.28);
    border-top: 2px solid rgb(255 214 130 / 0.55);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .spine[data-status='ordered'] :global(.spine__body) {
    background:
      repeating-linear-gradient(135deg, var(--c) 0 3px, transparent 3px 7px),
      color-mix(in oklch, var(--c) 30%, var(--paper));
    color: var(--ink);
  }

  /* A paper sticker keeps the title readable over the stripes. */
  .spine[data-status='ordered'] :global(.spine__title) {
    flex: 0 1 auto;
    padding: 0.3rem 0.1rem;
    border-radius: 1px;
    background: var(--paper-raised);
  }

  .spine[data-status='wishlist'] :global(.spine__body) {
    background: none;
    outline: 1.5px dashed color-mix(in oklch, var(--c) 70%, var(--ink));
    outline-offset: -1.5px;
    color: var(--ink-2);
  }

  .spine[data-status='wishlist'] :global(.spine__body)::before,
  .spine[data-status='wishlist'] :global(.spine__foot) {
    background: none;
    box-shadow: none;
    border-color: transparent;
  }

  .spine[data-status='read'] :global(.spine__body) {
    opacity: 0.45;
  }

  button.spine {
    cursor: pointer;
  }

  button.spine:hover :global(.spine__body) {
    transform: translateY(-0.35rem);
  }

  button.spine[aria-selected='true'] :global(.spine__body) {
    transform: translateY(-1.1rem);
    box-shadow:
      0 0 0 2px var(--paper),
      0 0 0 4px var(--magenta);
  }

  button.spine:focus-visible {
    outline: none;
  }

  button.spine:focus-visible :global(.spine__body) {
    outline: 2px solid var(--magenta);
    outline-offset: 2px;
  }

  /* The book that has come off the shelf, and what I wrote about it. */
  .shelf__detail {
    display: grid;
    gap: 1.5rem 2.5rem;
    align-items: center;
    margin-top: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 10px;
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
  }

  @media (min-width: 48rem) {
    .shelf__detail {
      grid-template-columns: minmax(20rem, 26rem) minmax(0, 1fr);
    }
  }

  .shelf__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 22rem;
    border-radius: 8px;
    background:
      radial-gradient(circle, color-mix(in srgb, var(--magenta) 45%, transparent) 0 32%, transparent 35%) 0 0 / 13px 13px,
      color-mix(in srgb, var(--process-yellow) 85%, var(--paper));
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  .shelf__stage:active {
    cursor: grabbing;
  }

  .shelf__stage.is-3d {
    min-height: 27rem;
  }

  .shelf__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  .shelf__text {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    align-self: start;
  }

  .shelf__hint {
    color: var(--ink-2);
  }

  .shelf__text :global(h3) {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .shelf__text :global(.shelf__meta) {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .shelf__text :global(.shelf__note) {
    margin-top: 0.5rem;
    max-width: var(--measure);
  }

  .shelf__random {
    margin-top: 0.75rem;
    padding: 0.4rem 0.9rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: none;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .shelf__random:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .shelf__tip {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  @media (pointer: coarse) {
    .shelf__tip {
      display: none;
    }
  }

  /* 3D book. Built by the script above; the faces meet at the edges of a box. */
  :global(.book3d) {
    --ry: 24deg;
    width: var(--bw);
    height: var(--bh);
    perspective: 1200px;
  }

  :global(.book3d__inner) {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(-7deg) rotateY(var(--ry));
  }

  :global(.book3d.is-turning .book3d__inner) {
    transition: transform 1100ms cubic-bezier(0.2, 0.9, 0.25, 1.05);
  }

  :global(.book3d__inner > *) {
    position: absolute;

---
import { Image } from 'astro:assets';
import { projects } from '~/data/projects';
---

<ol class="pgrid">
  {
    projects.map((project, index) => (
      <li class="pcard" style={`--brand-bg:${project.brand.bg};--brand-accent:${project.brand.accent};--tilt:${index % 2 === 0 ? -1.4 : 1.2}deg;--i:${index}`}>
        <a class="pcard__link" href={`/projects/${project.slug}/`}>
          <span class="pcard__shot" aria-hidden="true">
            <Image src={project.image} alt="" widths={[400, 640]} sizes="(min-width: 76rem) 18rem, (min-width: 40rem) 45vw, 100vw" loading="lazy" />
          </span>
          <span class="pcard__text">
            <span class="pcard__name">
              {project.name}
              {project.status && <span class="pcard__status">{project.status}</span>}
            </span>
            <span class="pcard__one">{project.oneLine}</span>
            <span class="pcard__highlights">
              {project.highlights.map((item) => (
                <span>{item}</span>
              ))}
            </span>
            <span class="pcard__cta">Read how it works</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  /* Every project in view at once, no carousel hiding most of them. */
  .pgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .pcard {
    display: grid;
  }

  .pcard__link {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--paper-raised);
    color: var(--ink);
    text-decoration: none;
    transition: transform 250ms var(--ease-out), box-shadow 250ms ease, border-color 150ms ease;
  }

  .pcard__link:hover {
    transform: translateY(-4px);
    border-color: var(--ink-3);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.45);
  }

  .pcard__shot {
    display: grid;
    place-items: center;
    padding: 1rem 1rem 0.75rem;
    background: var(--brand-bg);
    box-shadow: inset 0 -5px 0 var(--brand-accent);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .pcard__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    border-radius: 3px;
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.6);
    transform: rotate(var(--tilt));
    transition: transform 400ms var(--ease-out);
  }

  .pcard__link:hover .pcard__shot img {
    transform: rotate(0deg) scale(1.03);
  }

  .pcard__text {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1rem 1.125rem 1.25rem;
  }

  .pcard__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .pcard__status {
    padding: 0.05rem 0.5rem;
    border: 1px solid #1d2024;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
  }

  .pcard__one {
    font-size: var(--text-sm);
  }

  .pcard__highlights {
    display: grid;
    gap: 0.3rem;
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .pcard__highlights span {
    display: flex;
    gap: 0.5rem;
  }

  .pcard__highlights span::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.35em;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--brand-bg) 0 55%, var(--brand-accent) 55%);
  }

  .pcard__cta {
    margin-top: 0.25rem;
    color: var(--link);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

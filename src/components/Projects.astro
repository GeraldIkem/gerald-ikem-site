---
import { Image } from 'astro:assets';
import { projects } from '~/data/projects';
---

<ol class="project-list">
  {
    projects.map((project, index) => (
      <li class="project" style={`--brand-bg:${project.brand.bg};--brand-accent:${project.brand.accent};--tilt:${index % 2 === 0 ? -1.4 : 1.2}deg`}>
        <a class="project__shot" href={`/projects/${project.slug}/`} tabindex="-1" aria-hidden="true">
          <Image src={project.image} alt="" widths={[360, 560, 720]} sizes="(min-width: 52rem) 17rem, 100vw" loading="lazy" />
        </a>
        <div class="project__text">
          <h3>
            <a href={`/projects/${project.slug}/`}>{project.name}</a>
            {project.status && <span class="project__status">{project.status}</span>}
          </h3>
          <p class="project__one">{project.oneLine}</p>
          <ul class="project__highlights">
            {project.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="project__links">
            <a href={`/projects/${project.slug}/`}>Read how it works</a>
            <a href={project.url} class="project__live">{project.linkText}</a>
          </p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .project-list {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 52rem) {
    .project {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: 2.25rem;
    }
  }

  /* Each screenshot sits on a mat in its project's own colours. */
  .project__shot {
    display: grid;
    place-items: center;
    padding: 1rem;
    overflow: hidden;
    border-radius: 8px;
    background: var(--brand-bg);
    box-shadow: inset 0 -5px 0 var(--brand-accent);
    aspect-ratio: 4 / 3;
  }

  .project__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    border-radius: 3px;
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.6);
    transform: rotate(var(--tilt));
    transition: transform 400ms var(--ease-out);
  }

  .project:hover .project__shot img {
    transform: rotate(0deg) scale(1.02);
  }

  .project h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: var(--text-lg);
  }

  .project h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .project h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--brand-accent);
  }

  .project__status {
    padding: 0.1rem 0.55rem;
    border: 1px solid #1d2024;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
  }

  .project__one {
    margin-top: 0.5rem;
    max-width: 40rem;
  }

  .project__highlights {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .project__highlights li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .project__highlights li::before {
    content: '';
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--brand-bg) 0 55%, var(--brand-accent) 55%);
    transform: translateY(-0.05rem);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .project__live {
    color: var(--ink-2);
    font-weight: 400;
  }
</style>

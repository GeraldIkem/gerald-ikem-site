---
import { Image } from 'astro:assets';
import { projects } from '~/data/projects';
---

<project-rail class="rail">
  <div class="rail__bar">
    <p class="rail__count" aria-live="polite"><span data-at>1</span> of {projects.length}</p>
    <div class="rail__buttons">
      <button type="button" class="rail__btn" data-step="-1" aria-label="Previous projects">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="rail__btn" data-step="1" aria-label="More projects">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <ol class="rail__track" data-rail-track>
    {
      projects.map((project, index) => (
        <li class="pcard" style={`--brand-bg:${project.brand.bg};--brand-accent:${project.brand.accent};--tilt:${index % 2 === 0 ? -1.4 : 1.2}deg`}>
          <a class="pcard__link" href={`/projects/${project.slug}/`}>
            <span class="pcard__shot" aria-hidden="true">
              <Image src={project.image} alt="" widths={[400, 640]} sizes="22rem" loading="lazy" />
            </span>
            <span class="pcard__text">
              <span class="pcard__name">
                {project.name}
                {project.status && <span class="pcard__status">{project.status}</span>}
              </span>
              <span class="pcard__one">{project.oneLine}</span>
              <span class="pcard__highlights">
                {project.highlights.map((item) => (
                  <span>{item}</span>
                ))}
              </span>
              <span class="pcard__cta">Read how it works</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</project-rail>

<script>
  class ProjectRail extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-rail-track]');
      const at = this.querySelector('[data-at]');
      if (!track) return;
      const cards = [...track.children] as HTMLElement[];
      const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto';

      const step = (direction: number) => {
        const width = (cards[0]?.getBoundingClientRect().width ?? 300) + 20;
        track.scrollBy({ left: direction * width, behavior: smooth });
      };
      for (const button of this.querySelectorAll<HTMLButtonElement>('[data-step]')) {
        button.addEventListener('click', () => step(Number(button.dataset['step'])));
      }
      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') step(1);
        else if (event.key === 'ArrowLeft') step(-1);
        else return;
        event.preventDefault();
      });

      // Keep the counter on the first card that's fully in view.
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.intersectionRatio > 0.9).map((entry) => cards.indexOf(entry.target as HTMLElement));
          if (visible.length && at) at.textContent = String(Math.min(...visible) + 1);
        },
        { root: track, threshold: [0.9] },
      );
      cards.forEach((card) => observer.observe(card));
    }
  }
  customElements.define('project-rail', ProjectRail);
</script>

<style>
  .rail {
    display: block;
  }

  .rail__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .rail__count {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .rail__buttons {
    display: flex;
    gap: 0.5rem;
  }

  .rail__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .rail__btn:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .rail__btn svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* One row you slide through, each card snapping into place. */
  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(22rem, 84%);
    gap: 1.25rem;
    overflow-x: auto;
    padding: 0.25rem 0.25rem 1.25rem;
    margin: 0 -0.25rem;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .pcard {
    scroll-snap-align: start;
  }

  .pcard__link {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--paper-raised);
    color: var(--ink);
    text-decoration: none;
    transition: transform 250ms var(--ease-out), box-shadow 250ms ease, border-color 150ms ease;
  }

  .pcard__link:hover {
    transform: translateY(-4px);
    border-color: var(--ink-3);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.45);
  }

  .pcard__shot {
    display: grid;
    place-items: center;
    padding: 1rem 1rem 0.75rem;
    background: var(--brand-bg);
    box-shadow: inset 0 -5px 0 var(--brand-accent);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .pcard__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    border-radius: 3px;
    box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.6);
    transform: rotate(var(--tilt));
    transition: transform 400ms var(--ease-out);
  }

  .pcard__link:hover .pcard__shot img {
    transform: rotate(0deg) scale(1.03);
  }

  .pcard__text {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1rem 1.125rem 1.25rem;
  }

  .pcard__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .pcard__status {
    padding: 0.05rem 0.5rem;
    border: 1px solid #1d2024;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
  }

  .pcard__one {
    font-size: var(--text-sm);
  }

  .pcard__highlights {
    display: grid;
    gap: 0.3rem;
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .pcard__highlights span {
    display: flex;
    gap: 0.5rem;
  }

  .pcard__highlights span::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.35em;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--brand-bg) 0 55%, var(--brand-accent) 55%);
  }

  .pcard__cta {
    margin-top: 0.25rem;
    color: var(--link);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

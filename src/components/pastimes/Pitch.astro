---
/**
 * Football: shoot past the keeper. Played by src/scripts/pastimes.ts.
 */
import { PITCH } from '~/lib/pastimes';

const matchday = '/projects/matchday-ml/';
const kickSpot = PITCH.spots[0];
const keeperMid = (PITCH.goal.top + PITCH.goal.bottom) / 2;
const { goal, keeper } = PITCH;
---

<article class="pastime pastime--pitch" data-game="pitch">
  <div
    class="pastime__stage"
    tabindex="0"
    role="application"
    aria-label="Football: shoot past the keeper"
    aria-describedby="how-pitch"
  >
    <svg class="pastime__art" viewBox="0 0 320 170" aria-hidden="true">
      <rect class="pitch__grass" width="320" height="170" />
      <g class="pitch__stripes">
        <rect x="0" width="40" height="170" />
        <rect x="80" width="40" height="170" />
        <rect x="160" width="40" height="170" />
        <rect x="240" width="40" height="170" />
      </g>
      <g class="pitch__lines">
        <rect x="10" y="10" width="300" height="150" />
        <path d="M160 10v150" />
        <circle cx="160" cy="85" r="26" />
        <path d="M10 32h44v106H10M310 32h-44v106h44" />
        <path d="M10 52h14v66H10M310 52h-14v66h14" />
      </g>
      <rect
        class="pitch__net"
        data-net
        x={PITCH.right}
        y={goal.top}
        width={goal.depth}
        height={goal.bottom - goal.top}
      />
      <path class="pitch__goal" d={`M${PITCH.right} ${goal.top}h${goal.depth}v${goal.bottom - goal.top}h-${goal.depth}`} />
      <g class="keeper" data-keeper>
        <path class="keeper__arms" d={`M${keeper.x} ${keeperMid - keeper.half}v${keeper.half * 2}`} />
        <circle class="keeper__head" cx={keeper.x + 0.6} cy={keeperMid} r="2.3" />
      </g>
      <g class="aim" data-aim>
        <path class="aim__line" data-aim-line d="" />
        <path class="aim__head" data-aim-head d="" />
      </g>
      <g class="ball" data-ball transform={`translate(${kickSpot.x} ${kickSpot.y})`}>
        <circle class="aim__track" r="10" />
        <circle class="aim__ring" data-ring r="10" pathLength="100" transform="rotate(-90)" />
        <g data-spin>
          <g transform={`scale(${PITCH.ball / 8})`}>
            <circle class="pitch__ball" r="8" />
            <path
              class="pitch__patches"
              d="M0-5l4 3-1.5 4.5h-5L-4-2zM0-8v3M7-1l-3-1M5 6l-2-3.5M-5 6l2-3.5M-7-1l3-1"
            />
          </g>
        </g>
        <circle class="hit" data-hit r="22" />
      </g>
      <g data-burst></g>
    </svg>
    <p class="bug">
      <span>Goals <b data-goals>0</b></span>
      <span>Shots <b data-shots>0</b></span>
    </p>
    <p class="call" data-call aria-hidden="true">
      <span class="call__c"></span><span class="call__m"></span><span class="call__k"></span>
    </p>
  </div>
  <p class="pastime__how" id="how-pitch">
    Drag from the ball toward the goal and let go.
    <span class="pastime__keys">Keys: arrows to aim, Space to shoot.</span>
  </p>
  <div class="pastime__text">
    <h3>Football</h3>
    <p>The Premier League, La Liga and the Champions League. The two leagues are in Matchday ML as well.</p>
    <p class="pastime__tags"><span>Premier League</span><span>La Liga</span><span>Champions League</span></p>
    <a class="pastime__link" href={matchday}>See how the forecasts work</a>
  </div>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</article>

<style>
  @import './card.css';
  @import './scoreboard.css';
  @import './ball.css';

  /* Pitch */
  .pastime--pitch {
    --aim: #fff;
  }

  .pitch__grass {
    fill: var(--grass);
  }

  .pitch__stripes rect {
    fill: var(--grass-stripe);
  }

  .pitch__lines,
  .pitch__goal {
    fill: none;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: 2.5;
  }

  .pitch__goal {
    stroke-width: 3;
  }

  .pitch__net {
    fill: rgb(255 255 255 / 0.2);
    transform-box: fill-box;
    transform-origin: 0 50%;
  }

  .pitch__net.is-ripple {
    animation: ripple 600ms var(--ease-out);
  }

  @keyframes ripple {
    25% {
      transform: scaleX(1.45);
    }
  }

  .keeper__arms {
    stroke: #ffd60a;
    stroke-width: 4;
    stroke-linecap: round;
  }

  .keeper__head {
    fill: #2a1a10;
  }

  .pitch__ball {
    fill: #fff;
    stroke: #1d1d1d;
    stroke-width: 1.3;
  }

  .pitch__patches {
    fill: #1d1d1d;
    stroke: #1d1d1d;
    stroke-width: 1;
  }
</style>

---
/**
 * The bookshelf: pull a book off it. Played by src/scripts/pastimes.ts.
 */
---

<article class="pastime pastime--books" data-game="books">
  <div class="pastime__stage" tabindex="0" role="application" aria-label="Bookshelf" aria-describedby="how-books">
    <svg class="pastime__art" viewBox="0 0 320 170" aria-hidden="true">
      <rect class="books__wall" width="320" height="170" />
      <path class="books__plank" d="M30 146H290" />
      <g class="books__row">
        <rect data-book x="52" y="64" width="22" height="82" style="--b:var(--process-cyan)" />
        <rect data-book x="76" y="54" width="16" height="92" style="--b:var(--ink)" />
        <rect data-book x="94" y="72" width="26" height="74" style="--b:var(--process-magenta)" />
        <rect data-book x="122" y="48" width="20" height="98" style="--b:var(--process-yellow)" />
        <rect data-book x="144" y="60" width="18" height="86" style="--b:var(--ink-2)" />
        <rect data-book x="164" y="70" width="24" height="76" style="--b:var(--process-cyan)" />
        <rect data-book x="190" y="58" width="14" height="88" style="--b:var(--process-magenta)" />
        <rect
          data-book
          x="206"
          y="66"
          width="22"
          height="80"
          style="--b:var(--ink)"
          transform="rotate(14 228 146)"
        />
      </g>
    </svg>
  </div>
  <p class="pastime__how" id="how-books">
    Pick a book to pull it off the shelf.
    <span class="pastime__keys">Keys: arrows to choose, Space to pull.</span>
  </p>
  <div class="pastime__text">
    <h3>Books</h3>
    <p>Comics aren’t the only thing I collect. The bookshelf is filling up as well.</p>
  </div>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</article>

<style>
  @import './card.css';

  /* Books */
  .books__wall {
    fill: var(--wall);
  }

  .books__plank {
    stroke: var(--ink-2);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .books__row rect {
    fill: var(--b);
    stroke: color-mix(in srgb, var(--ink) 35%, transparent);
    stroke-width: 1;
    cursor: pointer;
    transition: translate 420ms var(--ease-out);
  }

  @media (hover: hover) {
    .books__row rect:hover:not(.is-out) {
      translate: 0 -4px;
    }
  }

  .books__row rect.is-out {
    translate: 0 -34px;
  }

  .pastime__stage:focus-visible .books__row rect.is-current {
    stroke: var(--magenta);
    stroke-width: 2.5;
  }
</style>

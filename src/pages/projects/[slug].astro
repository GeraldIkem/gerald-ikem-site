---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import RedirectDemo from '~/components/RedirectDemo.astro';
import RtfChart from '~/components/RtfChart.astro';
import StackTiles from '~/components/StackTiles.astro';
import { projects, type Project } from '~/data/projects';
import { layered } from '~/data/tech';
import { cellValue } from '~/lib/numbers';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      index,
      previous: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  index: number;
  previous: Project;
  next: Project;
}

const { project, index, previous, next } = Astro.props;
const brand = `--brand-bg:${project.brand.bg};--brand-accent:${project.brand.accent}`;
const idOf = (title: string) =>
  title
    .toLowerCase()
    .replace(/[’']/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const chapters = [
  { id: 'overview', title: 'Overview' },
  ...project.sections.map((section) => ({ id: idOf(section.title), title: section.title })),
  { id: 'limits', title: 'Limits and next' },
  { id: 'stack', title: 'Built with' },
];
const nextChapter = (id: string) => chapters[chapters.findIndex((chapter) => chapter.id === id) + 1];

const barsFor = (rows: string[][], column: number) => {
  const values = rows.map((row) => cellValue(row[column] ?? ''));
  const max = Math.max(...values.map((value) => value ?? 0));
  return values.map((value) => (value && max > 0 ? value / max : 0));
};

const prevUrl = `/projects/${previous.slug}/`;
const nextUrl = `/projects/${next.slug}/`;
const speculation = JSON.stringify({ prerender: [{ source: 'list', urls: [prevUrl, nextUrl] }] });
---

<Base title={project.name} description={`${project.name}: ${project.oneLine}`}>
  <script is:inline slot="head">
    // Tell the incoming page which way to slide, before it first paints.
    addEventListener('pagereveal', (event) => {
      let direction = null;
      try {
        direction = sessionStorage.getItem('case-direction');
        sessionStorage.removeItem('case-direction');
      } catch {}
      if (event.viewTransition && direction) event.viewTransition.types.add(direction);
    });
  </script>
  <script type="speculationrules" slot="head" set:html={speculation} />

  <article class="case" style={brand} data-prev={prevUrl} data-next={nextUrl} data-index={index}>
    <header class="case__band">
      <div class="case__head wrap">
        <div class="case__title">
          <p class="case__crumb">
            <a href="/#projects">Projects</a>
            <span>{index + 1} of {projects.length}</span>
          </p>
          <h1>
            {project.name}
            {project.status && <span class="case__status">{project.status}</span>}
          </h1>
          <p class="case__one">{project.oneLine}</p>
          <p class="case__links">
            <a href={project.url}>Visit {project.linkText}</a>
          </p>
        </div>

        <div class="case__viewer">
          <a class="case__arrow" href={prevUrl} rel="prev" data-dir="prev" aria-label={`Previous project: ${previous.name}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </a>
          <div class="case__shot">
            <Image src={project.image} alt={project.imageAlt} widths={[640, 960, 1280]} sizes="(min-width: 64rem) 34rem, 100vw" loading="eager" />
          </div>
          <a class="case__arrow" href={nextUrl} rel="next" data-dir="next" aria-label={`Next project: ${next.name}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <nav class="case__dots wrap" aria-label="All projects">
        {
          projects.map((item, itemIndex) => (
            <a
              href={`/projects/${item.slug}/`}
              data-dir={itemIndex < index ? 'prev' : 'next'}
              aria-current={item.slug === project.slug ? 'page' : undefined}
              style={`--dot:${item.brand.accent}`}
              title={item.name}
            >
              <span>{item.name}</span>
            </a>
          ))
        }
        <span class="case__hint">← → to switch projects, from anywhere on the page</span>
      </nav>
    </header>

    <!-- Arrows pinned to the edges of the screen, so you can switch projects without scrolling back up. -->
    <a class="edge edge--prev" href={prevUrl} data-dir="prev" style={`--edge:${previous.brand.bg};--edge-accent:${previous.brand.accent}`} aria-label={`Previous project: ${previous.name}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      <span class="edge__name">{previous.name}</span>
    </a>
    <a class="edge edge--next" href={nextUrl} data-dir="next" style={`--edge:${next.brand.bg};--edge-accent:${next.brand.accent}`} aria-label={`Next project: ${next.name}`}>
      <span class="edge__name">{next.name}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </a>

    <div class="case__layout wrap">
      <nav class="markers" aria-label="Chapters">
        <ol>
          {
            chapters.map((chapter, chapterIndex) => (
              <li>
                <a href={`#${chapter.id}`} id={`tab-${chapter.id}`} data-tab={chapter.id}>
                  <span class="markers__num">{chapterIndex + 1}</span>
                  <span class="markers__label">{chapter.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="case__content">
        <section class="chapter" id="overview" data-panel>
          <p class="case__lede">{project.intro}</p>
          <dl class="facts">
            {
              project.facts.map((fact) => (
                <div>
                  <dt data-count>{fact.value}</dt>
                  <dd>{fact.label}</dd>
                </div>
              ))
            }
          </dl>
          <a class="chapter__next" href={`#${nextChapter('overview')?.id}`} data-goto={nextChapter('overview')?.id}>
            Next: {nextChapter('overview')?.title}
          </a>
        </section>

        {
          project.sections.map((section) => {
            const id = idOf(section.title);
            const after = nextChapter(id);
            return (
              <section class="chapter" id={id} data-panel>
                <h2>{section.title}</h2>
                {section.body?.map((paragraph) => (
                  <p class="case__para">{paragraph}</p>
                ))}
                {section.demo === 'redirect' && <RedirectDemo />}
                {section.demo === 'rtf' && <RtfChart />}
                {section.problems && (
                  <div class="cards">
                    {section.problems.map((item) => (
                      <details class="card">
                        <summary>
                          <span class="card__title">{item.title}</span>
                          <span class="card__problem">{item.problem}</span>
                          <span class="card__more" aria-hidden="true">
                            How I fixed it
                          </span>
                        </summary>
                        <div class="card__body">
                          <p>{item.fix}</p>
                          {item.result && <p class="card__result">{item.result}</p>}
                        </div>
                      </details>
                    ))}
                  </div>
                )}
                {section.table && (
                  <div class="table-wrap">
                    <table>
                      {section.table.caption && <caption>{section.table.caption}</caption>}
                      <thead>
                        <tr>
                          {section.table.head.map((cell) => (
                            <th scope="col">{cell}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {(() => {
                          const table = section.table!;
                          const bars = table.bars === undefined ? null : barsFor(table.rows, table.bars);
                          return table.rows.map((row, rowIndex) => (
                            <tr>
                              {row.map((cell, column) =>
                                column === 0 ? (
                                  <th scope="row">{cell}</th>
                                ) : bars && column === table.bars ? (
                                  <td class="bar-cell">
                                    <span class="bar" style={`--w:${(bars[rowIndex] ?? 0) * 100}%`} />
                                    <span class="bar-value">{cell}</span>
                                  </td>
                                ) : (
                                  <td>{cell}</td>
                                ),
                              )}
                            </tr>
                          ));
                        })()}
                      </tbody>
                    </table>
                  </div>
                )}
                {section.points && (
                  <ul class="points">
                    {section.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
                {after && (
                  <a class="chapter__next" href={`#${after.id}`} data-goto={after.id}>
                    Next: {after.title}
                  </a>
                )}
              </section>
            );
          })
        }

        <section class="chapter" id="limits" data-panel>
          <h2>Limits and next</h2>
          <div class="pair">
            <div>
              <h3>Where it falls short</h3>
              <ul class="list">
                {project.limits.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3>What’s next</h3>
              <ul class="list">
                {project.next.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
          <a class="chapter__next" href="#stack" data-goto="stack">Next: Built with</a>
        </section>

        <section class="chapter" id="stack" data-panel>
          <h2>Built with</h2>
          <StackTiles groups={layered(project.stack).map((group) => ({ label: group.label, items: group.items.map((tech) => tech.name) }))} />
          <a class="chapter__next chapter__next--project" href={nextUrl} data-dir="next">
            Next project: {next.name}
          </a>
        </section>
      </div>
    </div>
  </article>
</Base>

<script>
  import { countFrame, splitNumbers } from '~/lib/numbers';

  const article = document.querySelector<HTMLElement>('.case');
  const motionOk = matchMedia('(prefers-reduced-motion: no-preference)').matches;

  /* ---------- Moving between projects ---------- */

  let leaving = false;
  function go(direction: 'prev' | 'next', url?: string) {
    const target = url ?? article?.dataset[direction];
    if (!target || leaving) return;
    leaving = true;
    try {
      sessionStorage.setItem('case-direction', direction === 'prev' ? 'slide-prev' : 'slide-next');
    } catch {
      // Without storage the page still changes, just without the slide direction.
    }
    location.href = target;
  }

  // Any link that moves between projects remembers which way it went.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-dir]')) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      go(link.dataset['dir'] === 'prev' ? 'prev' : 'next', link.href);
    });
  }

  // ← and → from anywhere, unless a control needs the keys.
  addEventListener('keydown', (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    const target = event.target as HTMLElement | null;
    if (target?.closest('input, textarea, select, [contenteditable], canvas, .table-wrap')) return;
    event.preventDefault();
    go(event.key === 'ArrowLeft' ? 'prev' : 'next');
  });

  // A sideways swipe, on a phone or a trackpad, anywhere that isn't itself scrollable sideways.
  const scrollsSideways = (node: EventTarget | null) => {
    for (let el = node as HTMLElement | null; el && el !== document.body; el = el.parentElement) {
      if (el.scrollWidth > el.clientWidth + 2 && /auto|scroll/.test(getComputedStyle(el).overflowX)) return true;
    }
    return false;
  };

  let touch: { x: number; y: number; ok: boolean } | null = null;
  addEventListener('touchstart', (event) => {
    const point = event.touches[0];
    touch = point ? { x: point.clientX, y: point.clientY, ok: !scrollsSideways(event.target) } : null;
  }, { passive: true });
  addEventListener('touchend', (event) => {
    const point = event.changedTouches[0];
    if (!touch?.ok || !point) return;
    const dx = point.clientX - touch.x;
    const dy = point.clientY - touch.y;
    touch = null;
    if (Math.abs(dx) > 80 && Math.abs(dx) > Math.abs(dy) * 1.8) go(dx < 0 ? 'next' : 'prev');
  });

  let wheelX = 0;
  let wheelTimer = 0;
  addEventListener('wheel', (event) => {
    if (Math.abs(event.deltaX) < Math.abs(event.deltaY) * 2 || scrollsSideways(event.target)) return;
    wheelX += event.deltaX;
    clearTimeout(wheelTimer);
    wheelTimer = window.setTimeout(() => (wheelX = 0), 250);
    if (Math.abs(wheelX) > 140) go(wheelX > 0 ? 'next' : 'prev');
  }, { passive: true });

  // The edge arrows appear once the header's own arrows have scrolled away.
  const band = document.querySelector('.case__band');
  if (band && article) {
    new IntersectionObserver(([entry]) => article.classList.toggle('is-past-head', !entry?.isIntersecting), {
      rootMargin: '-120px 0px 0px 0px',
    }).observe(band);
  }

  /* ---------- Chapters as tabs ---------- */

  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
  const panels = new Map([...document.querySelectorAll<HTMLElement>('[data-panel]')].map((panel) => [panel.id, panel]));
  const list = document.querySelector('.markers ol');
  list?.setAttribute('role', 'tablist');
  list?.setAttribute('aria-orientation', 'vertical');
  for (const tab of tabs) {
    tab.setAttribute('role', 'tab');
    tab.setAttribute('aria-controls', tab.dataset['tab'] ?? '');
    tab.parentElement?.setAttribute('role', 'presentation');
  }
  for (const panel of panels.values()) {
    panel.setAttribute('role', 'tabpanel');
    panel.setAttribute('aria-labelledby', `tab-${panel.id}`);
    panel.tabIndex = -1;
  }

  let current = '';
  function show(id: string, { focus = false, scroll = true } = {}) {
    if (!panels.has(id)) id = 'overview';
    const order = [...panels.keys()];
    const forward = order.indexOf(id) >= order.indexOf(current);
    for (const [panelId, panel] of panels) {
      const on = panelId === id;
      panel.hidden = !on;
      if (on && current && motionOk) {
        panel.classList.remove('enter-up', 'enter-down');
        void panel.offsetWidth;
        panel.classList.add(forward ? 'enter-up' : 'enter-down');
      }
    }
    for (const tab of tabs) {
      const on = tab.dataset['tab'] === id;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on) tab.scrollIntoView({ block: 'nearest', inline: 'center', behavior: motionOk ? 'smooth' : 'auto' });
    }
    current = id;
    history.replaceState(null, '', id === 'overview' ? location.pathname : `#${id}`);
    const layout = document.querySelector('.case__layout');
    if (scroll && layout && layout.getBoundingClientRect().top < 0) {
      layout.scrollIntoView({ behavior: motionOk ? 'smooth' : 'auto' });
    }
    if (focus) panels.get(id)?.focus({ preventScroll: true });
  }

  for (const tab of tabs) {
    tab.addEventListener('click', (event) => {
      event.preventDefault();
      show(tab.dataset['tab'] ?? 'overview');
    });
    tab.addEventListener('keydown', (event) => {
      const at = tabs.indexOf(tab);
      let to = -1;
      if (event.key === 'ArrowDown') to = (at + 1) % tabs.length;
      else if (event.key === 'ArrowUp') to = (at - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') to = 0;
      else if (event.key === 'End') to = tabs.length - 1;
      if (to < 0) return;
      event.preventDefault();
      const target = tabs[to];
      show(target?.dataset['tab'] ?? 'overview', { scroll: false });
      target?.focus();
    });
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-goto]')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      show(link.dataset['goto'] ?? 'overview', { focus: true });
    });
  }

  show(location.hash.slice(1) || 'overview', { scroll: false });

  /* ---------- Numbers that count up, bars that grow ---------- */

  if (motionOk) {
    const countObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        countObserver.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const final = el.textContent ?? '';
        const parts = splitNumbers(final);
        if (parts.length === 1 && typeof parts[0] === 'string') continue;
        el.setAttribute('aria-label', final);
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / 1100, 1);
          el.textContent = t < 1 ? countFrame(parts, 1 - (1 - t) ** 3) : final;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    document.querySelectorAll('[data-count]').forEach((counter) => countObserver.observe(counter));
  }

  const tableObserver = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add('is-shown');
      tableObserver.unobserve(entry.target);
    }
  }, { threshold: 0.3 });
  document.querySelectorAll('.table-wrap').forEach((table) => tableObserver.observe(table));
</script>

<style>
  /* Each project page wears its own colours at the top. */
  .case__band {
    background: var(--brand-bg);
    color: #fff;
    border-bottom: 6px solid var(--brand-accent);
  }

  .case__head {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding-block: clamp(1.5rem, 4vw, 2.75rem) 1rem;
  }

  @media (min-width: 64rem) {
    .case__head {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 3rem;
    }
  }

  .case__crumb {
    display: flex;
    gap: 1rem;
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.75);
  }

  .case__crumb a {
    color: rgb(255 255 255 / 0.92);
  }

  .case h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 0.6rem;
    font-size: clamp(2.5rem, 1rem + 5vw, 4.75rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .case__status {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--process-yellow);
    color: #1d2024;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
  }

  .case__one {
    margin-top: 0.875rem;
    max-width: 34rem;
    font-size: var(--text-md);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.9);
  }

  .case__links {
    margin-top: 1rem;
    font-weight: 600;
  }

  .case__links a {
    color: #fff;
    text-decoration-color: var(--brand-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .case__band :focus-visible {
    outline-color: #fff;
  }

  .case__viewer {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .case__shot img {
    width: 100%;
    height: auto;
    max-height: 22rem;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    box-shadow: 0 24px 50px -24px rgb(0 0 0 / 0.6);
  }

  .case__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    transition: background-color 150ms ease, transform 200ms var(--ease-out);
  }

  .case__arrow:hover {
    background: var(--brand-accent);
    color: #15181c;
  }

  .case__arrow[rel='prev']:hover {
    transform: translateX(-3px);
  }

  .case__arrow[rel='next']:hover {
    transform: translateX(3px);
  }

  .case__arrow svg,
  .edge svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .case__dots {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem 1.25rem;
  }

  .case__dots a {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.3);
    transition: width 250ms var(--ease-out), background-color 150ms ease;
  }

  .case__dots a:hover {
    background: var(--dot);
  }

  .case__dots a[aria-current='page'] {
    width: 2.25rem;
    background: var(--brand-accent);
  }

  .case__dots a span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .case__hint {
    margin-left: 0.75rem;
    color: #fff;
    font-size: var(--text-xs);
  }

  @media (pointer: coarse) {
    .case__hint {
      display: none;
    }
  }

  /* Arrows pinned to the screen edges once you've scrolled past the header. */
  .edge {
    position: fixed;
    top: 50%;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.25rem;
    padding: 0 0.85rem;
    background: var(--edge);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5);
    transition: opacity 250ms ease, transform 300ms var(--ease-out);
  }

  /* Tucked in at the edge of the screen, wherever you are on the page. */
  .edge--prev {
    left: 0;
    border-radius: 0 999px 999px 0;
    border-right: 4px solid var(--edge-accent);
    transform: translate(calc(-100% + 3.1rem), -50%);
  }

  .edge--next {
    right: 0;
    border-radius: 999px 0 0 999px;
    border-left: 4px solid var(--edge-accent);
    transform: translate(calc(100% - 3.1rem), -50%);
  }

  /* On hover the tab slides out to show where it goes. */
  .edge:hover,
  .edge:focus-visible {
    transform: translate(0, -50%);
  }

  .edge:focus-visible {
    outline: 3px solid var(--edge-accent);
  }

  .edge__name {
    white-space: nowrap;
    font-size: var(--text-sm);
  }

  /* Phones: small round buttons in the bottom corners, once the header's arrows are gone. */
  @media (pointer: coarse), (max-width: 40rem) {
    .edge {
      top: auto;
      bottom: 1rem;
      width: 2.9rem;
      height: 2.9rem;
      padding: 0;
      justify-content: center;
      border: 0;
      border-radius: 999px;
      opacity: 0;
      pointer-events: none;
    }

    .edge--prev {
      left: 0.75rem;
      transform: none;
    }

    .edge--next {
      right: 0.75rem;
      transform: none;
    }

    .edge:hover,
    .edge:focus-visible {
      transform: none;
    }

    .is-past-head .edge {
      opacity: 1;
      pointer-events: auto;
    }

    .edge__name {
      display: none;
    }
  }

  /* Chapters: a rail of numbered tabs beside one chapter at a time. */

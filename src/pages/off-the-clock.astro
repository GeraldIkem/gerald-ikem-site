---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Shelf from '~/components/Shelf.astro';
import Misregister from '~/components/Misregister.astro';
import LegoBricks from '~/components/LegoBricks.astro';
import LegoViewer from '~/components/LegoViewer.astro';
import Pastimes from '~/components/Pastimes.astro';
import { legoSets } from '~/data/lego';
import { countBy, type Book } from '~/lib/shelf';
import { site } from '~/data/site';

const comics: Book[] = (await getCollection('comics')).map((entry) => ({ ...entry.data, id: entry.id }));
const counts = countBy(comics);
const owned = comics.filter((book) => book.status === 'shelf');
const marvel = owned.filter((book) => book.publisher === 'Marvel Comics').length;
const dc = owned.filter((book) => book.publisher === 'DC Comics').length;
const built = legoSets.filter((set) => set.built).length;
const boxed = legoSets.length - built;
const tally = [
  { href: '#shelf', value: owned.length, label: 'comics on my shelf', ink: 'var(--process-cyan)' },
  { href: '#lego', value: built, label: `LEGO sets built, ${boxed} still boxed`, ink: 'var(--process-magenta)' },
  { href: '#sports', value: 4, label: 'leagues I forecast in Matchday ML', ink: 'var(--process-yellow)' },
];
---

<Base
  title="Off the clock"
  description="Gerald Ikem’s comic shelf, with his notes on every book, plus basketball, swimming, LEGO and books."
>
  <section class="intro wrap">
    <Misregister text="Off the clock" class="intro__title" />
    <p class="lede">
      Away from work I read comics, play basketball, swim, build LEGO and collect books. The comics take up the most
      room, so they get most of this page.
    </p>
    <nav class="tally" aria-label="On this page">
      {
        tally.map((item) => (
          <a class="tally__item" href={item.href} style={`--ink-mark:${item.ink}`}>
            <span class="tally__n" data-count>
              {item.value}
            </span>
            <span class="tally__label">{item.label}</span>
          </a>
        ))
      }
    </nav>
  </section>

  <section class="section section--wide wrap" id="shelf" aria-labelledby="shelf-title">
    <div class="section__head">
      <h2 id="shelf-title">The comic shelf</h2>
      <p>
        {owned.length} books on the shelf: {dc} from DC, {marvel} from Marvel. Each note says who made the book and
        where it sits in the run, because I read runs in order.
      </p>
      <p>
        The whole collection, pre-orders and reading orders included, lives in
        <a href={site.links.shelf}>Gerald’s shelf</a>, a tracker I’m building for it.
      </p>
    </div>
    <div class="section__body">
      <Shelf />
      <dl class="legend">
        <div>
          <dt><span class="swatch swatch--shelf"></span>Solid</dt>
          <dd>On my shelf</dd>
        </div>
        <div>
          <dt><span class="swatch swatch--ordered"></span>Striped</dt>
          <dd>Ordered, not here yet</dd>
        </div>
        <div>
          <dt><span class="swatch swatch--wishlist"></span>Outline</dt>
          <dd>On the wishlist</dd>
        </div>
        <div>
          <dt><span class="swatch swatch--read"></span>Faded</dt>
          <dd>Read, but no longer mine</dd>
        </div>
      </dl>
      <p class="fineprint">
        Each spine takes its colour from the book’s real cover, and picking a book wraps that cover round it.
        Height follows the format, and thickness follows the page count where I have it. The list comes straight from my collection catalogue: a short Python script turns its export into
        the data for this page, so the shelf stays current. Right now that’s {counts.ordered} on order and {counts.wishlist} on
        the wishlist.
      </p>
    </div>
  </section>

  <section class="section wrap" id="lego" aria-labelledby="lego-title">
    <div class="section__head">
      <h2 id="lego-title">LEGO</h2>
      <p>
        {built} sets built and {boxed} still waiting. Pick one of the 3D sets and watch it build itself, piece by piece.
      </p>
    </div>
    <div class="section__body">
      <LegoViewer />
      <LegoBricks />
      <p class="fineprint">
        The three sets marked 3D are exact digital models from the LDraw.org Official Model Repository, built from parts
        in the LDraw.org Parts Library (CC BY 2.0 and 4.0), and they build in the order of the real instructions. The
        other sets have no public 3D model yet. LEGO® is a trademark of the LEGO Group, which does not sponsor or endorse
        this site.
      </p>
    </div>
  </section>

  <section class="section wrap" id="sports" aria-labelledby="sports-title">
    <div class="section__head">
      <h2 id="sports-title">Sports and books</h2>
      <p>What fills the rest of the week.</p>
    </div>
    <div class="section__body">
      <Pastimes />
      <p class="back"><a href="/#work">Back to my work</a></p>
    </div>
  </section>
</Base>

<script>
  import { countFrame, splitNumbers } from '~/lib/numbers';

  // The tally counts up once, on arrival.
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    for (const el of document.querySelectorAll<HTMLElement>('.tally [data-count]')) {
      const final = el.textContent?.trim() ?? '';
      const parts = splitNumbers(final);
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / 900, 1);
        el.textContent = t < 1 ? countFrame(parts, 1 - (1 - t) ** 3) : final;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(2.5rem, 6vw, 4rem);
  }

  .intro :global(.intro__title) {
    font-size: clamp(2.75rem, 1rem + 7vw, 6rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .intro .lede {
    margin-top: 1.25rem;
    color: var(--ink-2);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 1.5rem;
    font-size: var(--text-xs);
  }

  .legend div {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .legend dt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  .legend dd {
    color: var(--ink-2);
  }

  .swatch {
    display: inline-block;
    width: 0.7rem;
    height: 1.1rem;
    border-radius: 2px 2px 0 0;
    background: oklch(0.4 0.11 245);
  }

  .swatch--ordered {
    background:
      repeating-linear-gradient(135deg, oklch(0.4 0.11 245) 0 3px, transparent 3px 7px),
      color-mix(in oklch, oklch(0.4 0.11 245) 30%, var(--paper));
  }

  .swatch--wishlist {
    background: none;
    outline: 1.5px dashed oklch(0.4 0.11 245);
    outline-offset: -1.5px;
  }

  .swatch--read {
    opacity: 0.45;
  }

  .fineprint {
    margin-top: 1rem;
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }


  /* The tally: three counts that double as links down the page. */
  .tally {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 44rem) {
    .tally {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 52rem;
    }
  }

  .tally__item {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid var(--rule-strong);
    border-bottom: 4px solid var(--ink-mark);
    border-radius: 8px;
    background: var(--paper-raised);
    color: var(--ink);
    text-decoration: none;
    transition: transform 200ms var(--ease-out), box-shadow 200ms ease;
  }

  .tally__item:hover,
  .tally__item:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -18px rgb(0 0 0 / 0.5);
  }

  .tally__n {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .tally__label {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  /* The shelf takes the full width, so the open book fits beside it. */
  .section--wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .section--wide .section__head {
    position: static;
  }

  .section--wide .section__head p {
    max-width: 40rem;
  }

  .back {
    margin-top: 3rem;
    font-weight: 600;
  }
</style>

---
import Base from '~/layouts/Base.astro';
---

<Base title="Page not found" description="This address doesn’t match a page on Gerald Ikem’s site." noindex>
  <section class="missing wrap">
    <h1>Nothing at this address</h1>
    <div class="missing__trace panel" aria-hidden="true">
      <div class="row">
        <span>Request</span><span class="track"><span class="bar" style="--l:0%;--w:100%"></span></span>
      </div>
      <div class="row">
        <span>Look up the route</span><span class="track"><span class="bar bar--setup" style="--l:0%;--w:38%"></span></span>
      </div>
      <div class="row">
        <span>Find the page</span><span class="track"><span class="bar bar--fail" style="--l:38%;--w:30%"></span></span>
      </div>
      <div class="row">
        <span>Respond</span><span class="track"><span class="bar" style="--l:68%;--w:32%"></span></span>
        <code class="status">404</code>
      </div>
    </div>
    <p class="lede">The link may be old, or there may be a typo in it. Everything on the site starts from the home page.</p>
    <p><a class="button" href="/">Go to the home page</a></p>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
  }

  .missing__trace {
    display: grid;
    gap: 0.5rem;
    width: min(100%, 36rem);
    padding: 1rem 1.125rem;
    font-size: var(--text-sm);
  }

  .row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.75rem;
  }

  .track {
    position: relative;
    height: 0.75rem;
  }

  .bar {
    position: absolute;
    inset-block: 0;
    left: var(--l);
    width: var(--w);
    border-radius: 2px;
    background: var(--span-transfer);
  }

  .bar--setup {
    background: var(--cyan);
  }

  .bar--fail {
    background: var(--magenta);
  }

  .status {
    color: var(--magenta);
    font-weight: 700;
  }

  .lede {
    color: var(--ink-2);
  }
</style>
